# Docker stack configuration for the RAG chat (copy to `.env`; `.env` is
# gitignored). Compose reads these; per-service backend tuning lives in
# chat-backend/.env.example.

# The generation model Ollama serves — always a local model, no hosted API,
# ever. Default qwen2.5:7b; switchable via `ragctl model`.
LLM_MODEL=qwen2.5:7b

# CORS origins allowed to call the backend. "*" is fine for local dev; for
# public use set the real site origin, e.g. https://mikkonumminen.dev
CORS_ALLOW_ORIGINS=*

# Cloudflare named-tunnel token (Cloudflare dashboard -> Zero Trust -> Networks
# -> Tunnels -> create a tunnel -> copy the token). ONLY needed to run the
# optional `tunnel` profile (`make up-public` / `make tunnel`) that publishes
# the backend over HTTPS. Leave blank when running the chat locally only.
TUNNEL_TOKEN=
