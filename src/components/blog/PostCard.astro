---
import type { CollectionEntry } from 'astro:content';
import { getTranslations } from '../../i18n';
import { formatEntryDate } from '../../lib/blog/entryDate';
import AiBadge from './AiBadge.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  href: string;
}

const { entry, href } = Astro.props;
const { title, description, date, locale, aiGenerated, hasAudio, tags } = entry.data;

const t = getTranslations(locale);
const dateLabel = formatEntryDate(date, locale);
---

<article class="post-card">
  <div class="post-card__meta">
    <time datetime={date.toISOString()}>{dateLabel}</time>
    {
      /*
      ALWAYS rendered, in both states, rather than a badge only on the posts that
      have narration. Nine of eleven entries have it, so marking only those would
      badge almost every card and leave the two exceptions defined by an absence,
      which is exactly the thing a reader cannot see. Saying which it is costs one
      short word and removes the guess.

      NOT aria-hidden, unlike the AI chip beside it. That one repeats a fact
      already inside the link's accessible name, so reading it twice is noise;
      this fact appears nowhere else on the card.
    */
    }
    <span class="post-card__audio" data-has-audio={hasAudio ? 'true' : 'false'}>
      {hasAudio ? t.blog.hasAudio : t.blog.noAudio}
    </span>
    {aiGenerated && <AiBadge decorative />}
  </div>

  <h2 class="post-card__title">
    <a href={href} class="post-card__link">
      {title}
      {aiGenerated && <span class="sr-only">{t.blog.aiBadge}</span>}
    </a>
  </h2>

  <p class="post-card__description">{description}</p>

  {
    tags.length > 0 && (
      <ul class="post-card__tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Reads as part of the meta line, not as a second badge competing with the AI
     chip: same mono/uppercase treatment as the date beside it. The two states
     differ in weight rather than colour, so "no audio" registers as a quieter
     fact and not as a warning about the post. */
  .post-card__audio {
    letter-spacing: inherit;
  }

  .post-card__audio[data-has-audio='true']::before {
    content: '▶ ';
    color: var(--color-term-green, #4ade80);
  }

  .post-card__audio[data-has-audio='false'] {
    opacity: 0.55;
  }

  .post-card__title {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  /* PARALLEL TO LatestEntries.astro: stretched hit area keeps the whole card
     clickable while the accessible name stays on the heading's own link. */
  .post-card__link {
    color: #fff;
    text-decoration: none;
  }

  .post-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__link:hover,
  .post-card__link:focus-visible {
    color: var(--color-home-accent);
  }

  .post-card__description {
    margin: 0;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
  }

  .post-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0.25rem 0 0;
  }

  .post-card__tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
  }
</style>
