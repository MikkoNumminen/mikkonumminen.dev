---
import { asLocale, getTranslations } from '../../i18n';

interface Props {
  /** `lg` is the entry page's disclosure header; `sm` rides along on cards. */
  size?: 'sm' | 'lg';
  /**
   * Card lists repeat the disclosure inside the entry link so it reaches the
   * link's accessible name; the chip is then a second announcement of the
   * same fact and is hidden from assistive tech rather than read twice.
   */
  decorative?: boolean;
}

const { size = 'sm', decorative = false } = Astro.props;

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<span class="ai-badge" data-size={size} aria-hidden={decorative ? 'true' : undefined}>
  {t.blog.aiBadge}
</span>

<style>
  /* Solid amber on ink rather than a tinted outline: the whole point of the
     badge is that a reader cannot mistake it for chrome, and every other
     accent on the site is in the blue/green family. */
  .ai-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    background: var(--color-term-amber);
    color: var(--color-ink);
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Sized to sit with the date and tag metadata it rides beside rather than
     below it: this is the element carrying the provenance claim, so it is
     never the smallest text in the card. */
  .ai-badge[data-size='sm'] {
    font-size: 0.7rem;
    padding: 0.3rem 0.6rem 0.3rem 0.72rem;
  }

  .ai-badge[data-size='lg'] {
    font-size: 0.78rem;
    padding: 0.5rem 0.85rem 0.5rem 1.07rem;
  }
</style>
