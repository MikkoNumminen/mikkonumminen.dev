---
import { linkifyBody } from '../lib/timeline/linkify';

interface Props {
  /** The body text to render. Project hosts inside the text become
   *  `<a target="_blank">` links via `linkifyBody`. */
  text: string;
  /** Localized "(opens in a new tab)" suffix appended to each link's
   *  aria-label. Pass `t.common.opensInNewTab` from the caller. */
  opensInNewTab: string;
}

const { text, opensInNewTab } = Astro.props;
const parts = linkifyBody(text);
---

{
  parts.map((part) =>
    part.type === 'link' ? (
      <a
        href={part.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${part.value} ${opensInNewTab}`}
      >
        {part.value}
      </a>
    ) : (
      part.value
    ),
  )
}
