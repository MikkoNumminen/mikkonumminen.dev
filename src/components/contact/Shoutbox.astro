---
// The moderated shoutbox, at the foot of the contact page.
//
// TWO HALVES WITH DIFFERENT DEPENDENCIES, and keeping them apart is the point.
//
// READ: approved threads come from a committed JSON file on the CDN, so the list
// is up whenever the SITE is up. It never touches the machine at home.
//
// WRITE: submitting needs the backend, so the form is gated on availability and
// simply is not offered when the machine is asleep. A visitor then sees the
// conversation and one quiet line saying sending is off, rather than a form that
// fails when they press it.
//
// Nothing here publishes. A submit puts a row in a moderation queue; the snapshot
// above only changes when the owner approves something and commits it.
//
// SURFACE, and why it is repeated rather than inherited: `.crt` is
// `min-height: 100vh` with its own radial gradient, and that gradient ENDS at
// the terminal's bottom edge. Anything appended after it lands on the plain body
// background (`--color-ink`), so this box has to carry the terminal's border,
// background and shadow itself or it reads as falling off the page.
//
// One component serves both breakpoints. `Terminal` and `MobileContactCard` are
// both always in the DOM and merely CSS-toggled at 640px, so this sits outside
// both and only its own width needs to track them.
import '../../styles/shoutbox.css';
import { getTranslations } from '../../i18n';

const t = getTranslations(Astro.currentLocale).shoutbox;
---

{
  /*
  The box sits below a full-height terminal (`.crt` is `min-height: 100vh`), so
  on arrival it is entirely off-screen and NOTHING on the page suggests it is
  there. The home page has always had a scroll hint for the same reason; the
  contact page never needed one until something was added underneath.

  Named rather than generic — "messages below" tells you what you would get,
  where a bare "scroll" only tells you that you can. Decorative and aria-hidden:
  the section itself is a labelled landmark, so assistive tech reaches it without
  this, and an announced "scroll" hint would be noise.

  Fixed rather than absolutely placed at the fold, because the terminal's height
  is a `dvh` calc that moves with mobile browser chrome; pinning to the viewport
  bottom is the one position that is right on every device.
*/
}
<div class="shoutbox__scroll-hint" data-shoutbox-hint aria-hidden="true">
  <span>{t.scrollHint}</span>
  <svg
    width="12"
    height="7"
    viewBox="0 0 12 7"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.4"></path>
  </svg>
</div>

<section class="shoutbox" aria-labelledby="shoutbox-title">
  <div class="shoutbox__card">
    <header class="shoutbox__chrome">
      {
        /*
        A REAL HEADING, not a styled span. Heading navigation is the primary way
        screen-reader users move through a page, and as a span this box was
        skipped by it entirely — the `aria-labelledby` region only helps someone
        who happens to navigate by landmark instead. It looks identical; the
        element is the whole point.
      */
      }
      <h2 class="shoutbox__title" id="shoutbox-title">{t.title}</h2>
    </header>

    <div class="shoutbox__screen">
      {
        /*
        NOT an aria-live region, deliberately. FieldLog.astro records the
        reasoning: a region that updates on its own clock with no pause control
        is a WCAG 2.2.2 Level A failure. This list is populated once on load, so
        a labelled region is the right surface and announcement is not.
      */
      }
      <ol
        class="shoutbox__threads"
        data-shoutbox-threads
        aria-label={t.threadsAria}
        hidden
      >
      </ol>

      {
        /*
        The default state. Shown until the snapshot loads AND turns out to have
        threads, so a missing file, a malformed file and a genuinely empty queue
        all land here rather than on three different failure paths. The file does
        not exist at all until the first message is approved.
      */
      }
      <p class="shoutbox__empty" data-shoutbox-empty>{t.empty}</p>

      {
        /*
        The write half. Ships `hidden` and is revealed only once the backend
        answers, so a visitor whose machine-at-home is asleep is never offered a
        form that cannot work. The thread list above is NOT gated on this: it
        comes from the committed snapshot and is up whenever the site is.

        `<details>` rather than a scripted tooltip, per the position stated in
        TechStack.astro: the native element already gives Enter, Space, tap and
        an exposed open state, and reaching for JavaScript would mean
        reimplementing all of it slightly worse. Hover is layered on in CSS.
      */
      }
      <form class="shoutbox__form" data-shoutbox-form hidden>
        <details class="shoutbox__info">
          <summary class="shoutbox__info-label">{t.infoLabel}</summary>
          <p class="shoutbox__info-body">{t.infoBody}</p>
        </details>

        <label class="sr-only" for="shoutbox-input">{t.placeholder}</label>
        <textarea
          class="shoutbox__input"
          id="shoutbox-input"
          data-shoutbox-input
          rows="2"
          placeholder={t.placeholder}
          autocomplete="off"
          spellcheck="true"></textarea>

        <button class="shoutbox__send" type="submit" data-shoutbox-send>
          {t.send}
        </button>
      </form>

      {
        /*
        THIS is the live region, not the thread list. It reports the outcome of
        something the visitor just did, which is exactly what aria-live is for —
        unlike a feed that updates on its own clock, which FieldLog.astro records
        as a WCAG 2.2.2 failure.
      */
      }
      <p
        class="shoutbox__status"
        data-shoutbox-status
        role="status"
        aria-live="polite"
        hidden
      >
      </p>

      <p class="shoutbox__legend">{t.legend}</p>
    </div>
  </div>
</section>

<script>
  import { onRoute } from '../../lib/lifecycle';
  import { loadSnapshot, formatThreadDate } from '../../lib/shoutbox/snapshot';
  import { submitShout } from '../../lib/shoutbox/submit';
  import {
    addPending,
    readPending,
    type PendingMessage,
  } from '../../lib/shoutbox/pending';
  import { isChatAvailable } from '../../lib/terminal/chat';
  import { getTranslations } from '../../i18n';

  onRoute(
    () => !!document.querySelector('[data-shoutbox-threads]'),
    () => {
      const list = document.querySelector<HTMLOListElement>('[data-shoutbox-threads]');
      const empty = document.querySelector<HTMLParagraphElement>('[data-shoutbox-empty]');
      if (!list || !empty) return;

      const t = getTranslations(document.documentElement.lang).shoutbox;
      const controller = new AbortController();

      // Retire the hint once it has been acted on. One-way: it never comes back
      // if the visitor scrolls up again, because by then they know the box is
      // there and a signpost that keeps reappearing is just clutter.
      //
      // `scroll` is passive so it can never delay scrolling, and the listener
      // removes itself on the first qualifying event rather than running for the
      // life of the page.
      // Retire the hint when the box it points at is actually on screen, not
      // after an arbitrary number of pixels.
      //
      // The first version fired at 80px of scroll, which is wrong in the case
      // that matters: the terminal is a full viewport tall, so 80px is a nudge
      // that reveals nothing. Someone who nudges and stops would lose the signal
      // while the box was still an entire screen away — the hint would have
      // disappeared precisely without doing its job.
      //
      // An IntersectionObserver retires it exactly when the card appears, and
      // disconnects itself: one-way, because by then they have seen the thing.
      const hint = document.querySelector<HTMLElement>('[data-shoutbox-hint]');
      const card = document.querySelector<HTMLElement>('.shoutbox__card');
      if (hint && card) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            hint.classList.add('shoutbox__scroll-hint--done');
            observer.disconnect();
          },
          // A sliver counts, but the sliver has to exist. An element whose top
          // edge sits exactly ON the viewport boundary touches the root with
          // ZERO area and the spec still reports it as intersecting, and the
          // terminal above is 100vh so the card starts exactly at the fold and
          // hits that case on load. Measured against the live site: at viewport
          // heights 800, 900, 1000 and 1200 the card had 0 visible pixels and
          // the hint was already retired. It is one-way, so it never came back,
          // which is the whole "there is no indicator" report.
          //
          // Shrinking the root by 1px at the bottom fixes it at the definition
          // rather than in the callback. Filtering on intersectionRect.height
          // instead does NOT work: the zero-area touch has already made
          // isIntersecting true, so growing to real size is not a threshold
          // crossing and the observer never fires again. Measured that too, by
          // scrolling to the box and watching the hint fail to retire.
          { threshold: 0, rootMargin: '0px 0px -1px 0px' },
        );
        observer.observe(card);
        controller.signal.addEventListener('abort', () => observer.disconnect());
      }

      /**
       * Build one thread's DOM.
       *
       * EVERY visitor-supplied string goes in through `textContent`. Never
       * `innerHTML`, never `insertAdjacentHTML`, never a template string of
       * markup. This text was typed by an anonymous stranger into a publicly
       * addressable endpoint; the backend gate rejects tag-shaped input as a
       * second layer, but this is the first one and the one that actually has to
       * hold. `textContent` makes markup impossible rather than filtered.
       */
      const renderThread = (thread: {
        id: number;
        body: string;
        at: string;
        reply: { body: string; at: string } | null;
      }): HTMLLIElement => {
        const item = document.createElement('li');
        item.className = 'shoutbox__thread';

        const stamp = document.createElement('time');
        stamp.className = 'shoutbox__stamp';
        const date = formatThreadDate(thread.at);
        // An unparseable date renders as absent rather than as "Invalid Date".
        if (date) {
          stamp.dateTime = date;
          stamp.textContent = date;
        }
        item.append(stamp);

        const body = document.createElement('p');
        body.className = 'shoutbox__body';
        body.textContent = thread.body;
        item.append(body);

        if (thread.reply) {
          // The owner's reply is visually distinct and attributed, so a visitor
          // can tell at a glance which half of the thread is mine. It is the
          // only attributed text here: submissions are anonymous.
          const reply = document.createElement('div');
          reply.className = 'shoutbox__reply';

          const who = document.createElement('span');
          who.className = 'shoutbox__reply-who';
          who.textContent = t.replyFrom;
          reply.append(who);

          const replyBody = document.createElement('p');
          replyBody.className = 'shoutbox__body';
          replyBody.textContent = thread.reply.body;
          reply.append(replyBody);

          item.append(reply);
        }

        return item;
      };

      /**
       * One of the visitor's OWN messages, accepted but not yet published.
       *
       * Same `textContent` discipline as `renderThread`, for the same reason: it
       * is the layer that actually holds. The dashed treatment and the badge are
       * the whole point of the element, so a visitor is never left thinking the
       * text below is on the site when it is only in their browser.
       */
      const renderPending = (entry: PendingMessage): HTMLLIElement => {
        const item = document.createElement('li');
        item.className = 'shoutbox__thread shoutbox__thread--pending';

        const stamp = document.createElement('time');
        stamp.className = 'shoutbox__stamp';
        const date = formatThreadDate(new Date(entry.at).toISOString());
        if (date) {
          stamp.dateTime = date;
          stamp.textContent = date;
        }
        item.append(stamp);

        const body = document.createElement('p');
        body.className = 'shoutbox__body';
        body.textContent = entry.body;
        item.append(body);

        const badge = document.createElement('p');
        badge.className = 'shoutbox__pending-badge';
        badge.textContent = t.queued;
        item.append(badge);

        return item;
      };

      /**
       * What the snapshot published, once it is known. Read by the pending
       * render to decide which local echoes are still honestly waiting; empty
       * until the fetch resolves, which only ever means an echo survives one
       * render longer than it needed to.
       */
      let publishedBodies: string[] = [];

      /**
       * Re-render the pending echoes from storage, replacing whatever is there.
       *
       * IDEMPOTENT ON PURPOSE. A submit that lands before `loadSnapshot`
       * resolves would otherwise append an echo, and then the snapshot pass
       * would read the same entry back out of storage and append it a second
       * time. Rebuilding instead of appending makes that unrepresentable, and it
       * keeps the echoes last in the list no matter which pass ran first.
       */
      const renderPendingList = (): void => {
        for (const node of list.querySelectorAll('.shoutbox__thread--pending'))
          node.remove();
        for (const entry of readPending(publishedBodies))
          list.append(renderPending(entry));
        // Nothing published and nothing pending leaves the empty state exactly
        // as rendered. Nothing to undo, and no spinner was ever shown to clear.
        const populated = list.childElementCount > 0;
        list.hidden = !populated;
        empty.hidden = populated;
      };

      void loadSnapshot().then((snapshot) => {
        if (controller.signal.aborted) return;

        const threads = snapshot?.threads ?? [];
        publishedBodies = threads.map((thread) => thread.body);
        for (const thread of threads) list.append(renderThread(thread));
        renderPendingList();
      });

      // --- the write half ------------------------------------------------
      //
      // Gated on the SAME availability signal the chat uses, deliberately, and
      // with no second /health probe: `isChatAvailable()` reads module state the
      // terminal's (or the mobile card's) poller already keeps current, so after
      // the first probe this costs nothing on the network.
      //
      // That signal is `checks.llm`, which is strictly a proxy for "the machine
      // is awake" — the shoutbox needs the HTTP service, not the model. They go
      // up and down together under `ragctl up` / `down`, so the proxy holds; the
      // one gap is the ~40s while a cold model loads, during which the form stays
      // hidden. Hiding a form that would work is a smaller failure than offering
      // one that would not.
      const form = document.querySelector<HTMLFormElement>('[data-shoutbox-form]');
      const input = document.querySelector<HTMLTextAreaElement>('[data-shoutbox-input]');
      const send = document.querySelector<HTMLButtonElement>('[data-shoutbox-send]');
      const status = document.querySelector<HTMLParagraphElement>(
        '[data-shoutbox-status]',
      );

      const say = (text: string): void => {
        if (!status) return;
        // textContent, like everything else here.
        status.textContent = text;
        status.hidden = false;
      };

      if (form && input && send && status) {
        // TRACKED, not sampled once. The terminal reveals and hides its chat as
        // the operator toggles the stack, without a reload; a box that decided
        // once at mount would sit showing "sending is off" for the rest of the
        // session after the machine woke up thirty seconds later.
        //
        // This costs nothing on the network: `isChatAvailable()` returns the
        // value the terminal's own poller keeps current, and only probes if no
        // poller has run yet. The interval is just how often we read that value.
        const AVAILABILITY_TICK_MS = 10_000;
        let lastKnown: boolean | null = null;

        const applyAvailability = (available: boolean): void => {
          if (available === lastKnown) return;
          lastKnown = available;
          form.hidden = !available;
          if (available) {
            // Clear the offline line, but never clobber a queued/refused message
            // the visitor still needs to read.
            if (status.textContent === t.offline) status.hidden = true;
          } else {
            // One quiet line in the site's register. No spinner, no retry
            // button, no popup — the box says the door is shut right now.
            say(t.offline);
          }
        };

        const pollAvailability = (): void => {
          void isChatAvailable().then((available) => {
            if (controller.signal.aborted) return;
            applyAvailability(available);
          });
        };

        pollAvailability();
        const tick = window.setInterval(pollAvailability, AVAILABILITY_TICK_MS);
        controller.signal.addEventListener('abort', () => window.clearInterval(tick));

        // Hover-reveal for the info disclosure, driven from pointer events
        // rather than CSS.
        //
        // The CSS-only version was fragile: a closed `<details>` hides its
        // children through UA behaviour that a `display` override does not
        // reliably beat across browsers, so the panel might simply never appear
        // on hover while looking correct in the stylesheet. Toggling the real
        // `open` attribute uses the element's own mechanism, so it behaves the
        // same everywhere.
        //
        // This is NOT reimplementing the disclosure — click, Enter, Space and
        // tap all remain native, which is the whole reason for `<details>`. It
        // only adds the third input the brief asked for. Guarded on
        // `hover: hover` so a tap never leaves the panel stuck open on touch.
        const info = document.querySelector<HTMLDetailsElement>('.shoutbox__info');
        if (info && window.matchMedia('(hover: hover)').matches) {
          info.addEventListener('pointerenter', () => (info.open = true), {
            signal: controller.signal,
          });
          info.addEventListener(
            'pointerleave',
            () => {
              // Leave it open if the visitor actually clicked it: they asked.
              if (!info.dataset.pinned) info.open = false;
            },
            { signal: controller.signal },
          );
          info.addEventListener('click', () => (info.dataset.pinned = 'true'), {
            signal: controller.signal,
          });
        }

        form.addEventListener(
          'submit',
          (event) => {
            event.preventDefault();
            const body = input.value;
            // Silent no-op would make the button look broken, and the native
            // `required` bubble is a popup, which this feature does not use.
            // Putting the cursor where the problem is says it without either.
            if (!body.trim()) {
              input.focus();
              return;
            }

            // Disabled for the round trip so a double-tap cannot queue twice.
            // No spinner: the button going quiet is the whole feedback.
            send.disabled = true;
            input.disabled = true;

            void submitShout(body).then((outcome) => {
              if (controller.signal.aborted) return;
              send.disabled = false;
              input.disabled = false;

              if (outcome.kind === 'queued') {
                input.value = '';
                say(t.queued);
                // Echo it back immediately. The status line alone told them the
                // send worked and then left no trace of WHAT worked, which on a
                // board whose published list moves in days read as nothing
                // having happened at all.
                addPending(body);
                renderPendingList();
                return;
              }
              // The gate's own wording, verbatim: it is specific and actionable,
              // and paraphrasing it here would put the rule in two places.
              say(outcome.kind === 'refused' ? outcome.detail : t.failed);
            });
          },
          { signal: controller.signal },
        );
      }

      return () => controller.abort();
    },
  );
</script>
