---
import '../../styles/mobile-contact-card.css';
import { asLocale, getTranslations } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

const m = t.mobileContact;
---

<section class="mcc" aria-label={m.cardAria}>
  <div class="mcc__vignette" aria-hidden="true"></div>
  <div class="mcc__scanlines" aria-hidden="true"></div>
  <div class="mcc__flicker" aria-hidden="true"></div>

  <div class="mcc__card">
    <header class="mcc__chrome" aria-hidden="true">
      <div class="mcc__dots">
        <span class="mcc__dot mcc__dot--red"></span>
        <span class="mcc__dot mcc__dot--amber"></span>
        <span class="mcc__dot mcc__dot--green"></span>
      </div>
      <div class="mcc__title">{t.contactPage.windowTitle}</div>
      <div class="mcc__chrome-spacer"></div>
    </header>

    <div class="mcc__screen">
      <div
        class="mcc__output"
        id="mcc-output"
        aria-hidden="true"
        data-whoami-name={m.typedWhoamiOutputName}
        data-whoami-bio={m.typedWhoamiOutputBio}
        data-label-email={m.typedContactLabelEmail}
        data-label-linkedin={m.typedContactLabelLinkedin}
        data-label-github={m.typedContactLabelGithub}
        data-label-location={m.typedContactLabelLocation}
        data-value-location={m.typedContactValueLocation}
        data-download-output={m.typedDownloadOutput}
      >
      </div>
      <form class="mcc__chatform" id="mcc-chatform" hidden autocomplete="off">
        <span class="mcc__prompt" aria-hidden="true">$</span>
        <input
          class="mcc__chatinput"
          id="mcc-input"
          type="text"
          inputmode="text"
          enterkeyhint="send"
          autocomplete="off"
          placeholder="ask about the projects…"
          aria-label="Ask the assistant about the projects"
        />
      </form>
    </div>
  </div>

  <div class="mcc__actions">
    <a class="mcc__btn" href="mailto:numminen.mikko.petteri@gmail.com">
      {m.btnEmail}
    </a>
    <a
      class="mcc__btn"
      href="https://www.linkedin.com/in/mikko-numminen-269795205/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={m.ariaLinkedIn}
    >
      {m.btnLinkedin}
    </a>
    <a
      class="mcc__btn"
      href="/mikko-numminen-cv.pdf"
      download="mikko-numminen-cv.pdf"
      data-astro-prefetch="false"
    >
      {m.btnDownloadCv}
    </a>
  </div>
</section>

<script>
  import { onRoute } from '../../lib/lifecycle';

  // Auto-played scripted terminal session for the mobile contact card.
  // Plain DOM, no GSAP. Respects prefers-reduced-motion.

  type Step =
    | { kind: 'cmd'; text: string }
    | { kind: 'out'; text: string }
    | { kind: 'pair'; label: string; value: string }
    | { kind: 'gap' };

  const PROMPT = '$';
  const CHAR_DELAY_MS = 30;
  const POST_OUTPUT_PAUSE_MS = 250;
  const POST_CMD_PAUSE_MS = 140;

  const start = () => {
    const output = document.getElementById('mcc-output');
    if (!output) return;

    const reduced =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const data = output.dataset;
    const whoamiName = data.whoamiName ?? '';
    const whoamiBio = data.whoamiBio ?? '';
    const labelEmail = data.labelEmail ?? 'email';
    const labelLinkedin = data.labelLinkedin ?? 'linkedin';
    const labelGithub = data.labelGithub ?? 'github';
    const labelLocation = data.labelLocation ?? 'location';
    const valueLocation = data.valueLocation ?? '';
    const downloadOutput = data.downloadOutput ?? 'ready.';

    const steps: Step[] = [
      { kind: 'cmd', text: 'whoami' },
      { kind: 'out', text: whoamiName },
      { kind: 'out', text: whoamiBio },
      { kind: 'gap' },
      { kind: 'cmd', text: 'contact --list' },
      {
        kind: 'pair',
        label: labelEmail,
        value: 'numminen.mikko.petteri@gmail.com',
      },
      {
        kind: 'pair',
        label: labelLinkedin,
        value: 'linkedin.com/in/mikko-numminen-269795205',
      },
      { kind: 'pair', label: labelGithub, value: 'github.com/MikkoNumminen' },
      { kind: 'pair', label: labelLocation, value: valueLocation },
      { kind: 'gap' },
      { kind: 'cmd', text: 'download --cv' },
      { kind: 'out', text: downloadOutput },
    ];

    const timeouts = new Set<number>();
    let cancelled = false;

    const wait = (ms: number): Promise<void> =>
      new Promise((resolve) => {
        const id = window.setTimeout(() => {
          timeouts.delete(id);
          resolve();
        }, ms);
        timeouts.add(id);
      });

    const raf = (): Promise<void> =>
      new Promise((resolve) => {
        requestAnimationFrame(() => resolve());
      });

    const makeLine = (className: string): HTMLElement => {
      const el = document.createElement('span');
      el.className = `mcc__line ${className}`;
      return el;
    };

    const makePromptSpan = (): HTMLElement => {
      const span = document.createElement('span');
      span.className = 'mcc__prompt';
      span.textContent = PROMPT;
      return span;
    };

    const renderAllStatic = (): void => {
      const frag = document.createDocumentFragment();
      for (const step of steps) {
        if (step.kind === 'gap') {
          const gap = document.createElement('span');
          gap.className = 'mcc__line';
          gap.textContent = '\u00a0';
          frag.appendChild(gap);
          continue;
        }
        if (step.kind === 'cmd') {
          const line = makeLine('mcc__line--cmd');
          line.appendChild(makePromptSpan());
          const cmd = document.createElement('span');
          cmd.textContent = step.text;
          line.appendChild(cmd);
          frag.appendChild(line);
          continue;
        }
        if (step.kind === 'out') {
          const line = makeLine('mcc__line--out');
          line.textContent = step.text;
          frag.appendChild(line);
          continue;
        }
        if (step.kind === 'pair') {
          const line = makeLine('mcc__line--pair');
          const label = document.createElement('span');
          label.className = 'mcc__label';
          label.textContent = step.label;
          const value = document.createElement('span');
          value.className = 'mcc__value';
          value.textContent = step.value;
          line.appendChild(label);
          line.appendChild(value);
          frag.appendChild(line);
        }
      }

      const idle = document.createElement('span');
      idle.className = 'mcc__idle-prompt';
      idle.appendChild(makePromptSpan());
      const cursor = document.createElement('span');
      cursor.className = 'mcc__cursor';
      idle.appendChild(cursor);
      frag.appendChild(idle);

      output.appendChild(frag);
    };

    const typeCommand = async (text: string): Promise<void> => {
      if (cancelled) return;
      const line = makeLine('mcc__line--cmd');
      line.appendChild(makePromptSpan());
      const cmdSpan = document.createElement('span');
      line.appendChild(cmdSpan);
      const cursor = document.createElement('span');
      cursor.className = 'mcc__cursor';
      line.appendChild(cursor);
      output.appendChild(line);
      await raf();

      for (const ch of text) {
        if (cancelled) return;
        cmdSpan.textContent = (cmdSpan.textContent ?? '') + ch;
        await wait(CHAR_DELAY_MS);
      }

      // Remove the typing cursor once the command is fully typed.
      if (cursor.parentNode) cursor.parentNode.removeChild(cursor);
    };

    const printOut = async (text: string): Promise<void> => {
      if (cancelled) return;
      const line = makeLine('mcc__line--out');
      line.textContent = text;
      output.appendChild(line);
      await raf();
    };

    const printPair = async (label: string, value: string): Promise<void> => {
      if (cancelled) return;
      const line = makeLine('mcc__line--pair');
      const labelEl = document.createElement('span');
      labelEl.className = 'mcc__label';
      labelEl.textContent = label;
      const valueEl = document.createElement('span');
      valueEl.className = 'mcc__value';
      valueEl.textContent = value;
      line.appendChild(labelEl);
      line.appendChild(valueEl);
      output.appendChild(line);
      await raf();
    };

    const printGap = async (): Promise<void> => {
      if (cancelled) return;
      const gap = document.createElement('span');
      gap.className = 'mcc__line';
      gap.textContent = '\u00a0';
      output.appendChild(gap);
      await raf();
    };

    const renderIdlePrompt = (): void => {
      const idle = document.createElement('span');
      idle.className = 'mcc__idle-prompt';
      idle.appendChild(makePromptSpan());
      const cursor = document.createElement('span');
      cursor.className = 'mcc__cursor';
      idle.appendChild(cursor);
      output.appendChild(idle);
    };

    const cleanup = (): void => {
      cancelled = true;
      for (const id of timeouts) window.clearTimeout(id);
      timeouts.clear();
    };

    // `cleanup` is returned as the disposer; onRoute runs it on astro:before-swap
    // (client-side nav) and on pagehide (full unload / bfcache freeze), so no
    // per-mount window listeners are registered here — those weren't bound to a
    // controller and stacked on every /contact re-mount.
    if (reduced) {
      renderAllStatic();
      return cleanup;
    }

    void (async () => {
      for (const step of steps) {
        if (cancelled) return;
        if (step.kind === 'cmd') {
          await typeCommand(step.text);
          await wait(POST_CMD_PAUSE_MS);
        } else if (step.kind === 'out') {
          await printOut(step.text);
          await wait(POST_OUTPUT_PAUSE_MS);
        } else if (step.kind === 'pair') {
          await printPair(step.label, step.value);
          await wait(80);
        } else if (step.kind === 'gap') {
          await printGap();
        }
      }
      if (cancelled) return;
      renderIdlePrompt();
    })();

    return cleanup;
  };

  // Mount per contact arrival, dispose (cancel the typing chain + timeouts) on
  // leaving, so the setTimeout chain can't keep firing against swapped-away DOM.
  onRoute(
    () => !!document.getElementById('mcc-output'),
    () => start(),
  );
</script>

<script>
  // Progressive enhancement: when the local RAG backend is actually answering,
  // turn the phone card's static terminal into a real chat — a tappable input
  // (which opens the keyboard, unlike the static showcase) wired to the same
  // `/chat` stream the desktop terminal uses. With no backend configured or one
  // that's unreachable, nothing is revealed and the card stays showcase + buttons.
  import {
    getChatBaseUrl,
    startChatAvailabilityPolling,
    streamChat,
  } from '../../lib/terminal/chat';
  import type { ChatHandlers, ChatSource } from '../../lib/terminal/chat';
  import { onRoute } from '../../lib/lifecycle';

  const wireChat = () => {
    // Mobile only: above 640px the desktop terminal owns the chat poll, so the
    // page never double-probes /health. (CSS hides this card there anyway; if
    // matchMedia is unavailable we defer to the desktop poller and do nothing.)
    // Evaluated once per wireChat run — crossing 640px at runtime needs a reload
    // to swap which component owns the chat (like prefers-reduced-motion).
    if (
      typeof window.matchMedia !== 'function' ||
      !window.matchMedia('(max-width: 640px)').matches
    )
      return;
    const base = getChatBaseUrl();
    if (!base) return;
    const form = document.querySelector<HTMLFormElement>('#mcc-chatform');
    const input = document.querySelector<HTMLInputElement>('#mcc-input');
    const output = document.querySelector<HTMLElement>('#mcc-output');
    if (!form || !input || !output) return;
    // `.mcc__screen` — gets `--chat` while the input is live so the static idle
    // prompt ("$ ▏") is hidden (the live input below is the prompt then).
    const screen = output.parentElement;

    // One controller owns everything this wiring registers; onRoute aborts it on
    // astro:before-swap (client-side navigation away). It is deliberately NOT
    // aborted on pagehide: a bfcache freeze already pauses the poller's timers, so
    // leaving the listeners attached lets the chat resume intact on a Back-restore
    // — an abort here would leave it dead, since onRoute does not re-mount on
    // pageshow. Every listener + the in-flight stream is bound to the signal.
    const controller = new AbortController();
    const { signal } = controller;

    // Tapping anywhere in the terminal box (not just the thin input line) focuses
    // the input — the small line was a poor touch target. focus() called inside
    // the tap gesture is what brings the keyboard up on mobile; mirrors the
    // desktop terminal's click-to-focus.
    const card = document.querySelector<HTMLElement>('.mcc__card');
    card?.addEventListener(
      'click',
      (event) => {
        const target = event.target as HTMLElement;
        if (target.tagName === 'A' || target === input || form.hidden) return;
        if (!input.disabled) input.focus();
      },
      { signal },
    );

    const append = (cls: string, text: string): HTMLElement => {
      const el = document.createElement('span');
      el.className = `mcc__line ${cls}`;
      el.textContent = text;
      output.appendChild(el);
      output.scrollTop = output.scrollHeight;
      return el;
    };

    let busy = false;
    form.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        const question = input.value.trim();
        if (!question || busy) return;
        busy = true;
        input.value = '';
        input.disabled = true;

        const cmd = document.createElement('span');
        cmd.className = 'mcc__line mcc__line--cmd';
        const prompt = document.createElement('span');
        prompt.className = 'mcc__prompt';
        prompt.textContent = '$';
        const echo = document.createElement('span');
        echo.textContent = ` ${question}`;
        cmd.append(prompt, echo);
        output.appendChild(cmd);

        let answer: HTMLElement | null = null;
        // `settled` keeps finish idempotent, so an SSE error frame followed by a
        // stream throw can't print two error lines or double-enable the input.
        let settled = false;
        const finish = (): void => {
          if (settled) return;
          settled = true;
          busy = false;
          input.disabled = false;
          if (!form.hidden) input.focus();
        };
        const handlers: ChatHandlers = {
          onSources: (sources: ChatSource[]) => {
            const seen = new Set<string>();
            for (const s of sources) {
              if (seen.has(s.source)) continue;
              seen.add(s.source);
              append('mcc__line--src', `→ ${s.source.replace(/\.md$/, '')}`);
            }
          },
          onToken: (tok: string) => {
            if (!answer) answer = append('mcc__line--out', '');
            answer.textContent = `${answer.textContent ?? ''}${tok}`;
            output.scrollTop = output.scrollHeight;
          },
          onDone: finish,
          onError: (message: string) => {
            if (settled) return;
            append('mcc__line--out', `⚠ ${message}`);
            finish();
          },
        };

        void streamChat(base, question, handlers, { signal }).catch(() => {
          if (settled || signal.aborted) return;
          append('mcc__line--out', '⚠ chat is unavailable right now.');
          finish();
        });
      },
      { signal },
    );

    // Reveal the input live when the backend comes up and hide it when it goes
    // down — shares the desktop poller's exponential backoff, so a down stack
    // isn't hammered. The handlers above are wired once; only visibility flips.
    startChatAvailabilityPolling(
      (available) => {
        form.hidden = !available;
        screen?.classList.toggle('mcc__screen--chat', available);
      },
      { signal },
    );

    return () => controller.abort();
  };

  // Mount per contact arrival, dispose (abort the controller — every listener,
  // the in-flight stream, and the availability poller) on leaving. Under
  // ClientRouter, in-site back/forward is a client-side navigation that fires
  // astro:page-load, so onRoute re-mounts it — replacing the old bfcache
  // pageshow re-arm. The internal `pagehide` abort stays as a full-unload guard.
  onRoute(
    () => !!document.getElementById('mcc-output'),
    () => wireChat(),
  );
</script>
