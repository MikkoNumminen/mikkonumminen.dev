---
import { asLocale, getTranslations, localizePath } from '../../i18n';
import { cvPaper, paperUrl } from '../../data/papers';
import { publicFileSize } from '../../lib/publicFileSize';
import HeroVoiceover from './HeroVoiceover.astro';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

const cv = cvPaper();
const cvSize = publicFileSize(cv.filename);
---

<section class="hero" data-section-hero aria-label={t.hero.sectionAria}>
  <HeroVoiceover />

  <div class="hero__masthead">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <p class="hero__subtitle">{t.hero.subtitle}</p>

    {
      /* The one action on the cover. It sits in the masthead rather than in
        a fixed corner because every corner is already spoken for (audio
        bottom-left, field log bottom-right, coordinate markers top), and
        because the masthead is the only block that renders identically on
        all three paths: the WebGL field, the ≤640px fallback and
        reduced-motion. One control, no duplicate to keep in step.

        `download` plus an explicit filename, so the browser saves rather
        than opening a viewer tab the visitor then has to save out of. */
    }
    <div class="hero__cv-row">
      <a
        class="hero__cv"
        href={paperUrl(cv)}
        download={cv.filename}
        data-astro-prefetch="false"
        aria-label={t.common.downloadCvAria.replace('{size}', cvSize)}
      >
        <span class="hero__cv-label">{t.hero.cvLabel}</span>
        <span class="hero__cv-size" aria-hidden="true">{cvSize}</span>
      </a>

      {
        /* Beside the pill rather than under it. A second line here costs about
          27px of masthead height, and at 360x640 the masthead already came
          within 10px of the fallback title before the pill existed; a row
          keeps the block one line tall. */
      }
      <a
        class="hero__cv-read"
        href={localizePath('/cv', locale)}
        aria-label={t.hero.cvReadAria}
      >
        {t.hero.cvReadLabel}
      </a>
    </div>
  </div>

  <div class="hero__content">
    <h1 class="hero__title sr-only">{t.hero.titleSrOnly}</h1>

    <p class="hero__title-fallback" data-fallback>
      {t.hero.titleFallbackTop}<br />{t.hero.titleFallbackBottom}
    </p>
  </div>

  <div class="hero__scroll-hint" data-scroll-hint aria-hidden="true">
    <span>{t.hero.scrollHint}</span>
    <svg
      width="14"
      height="22"
      viewBox="0 0 14 22"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="0.5" y="0.5" width="13" height="21" rx="6.5" stroke="currentColor"></rect>
      <circle cx="7" cy="7" r="1.5" fill="currentColor" class="hero__scroll-circle"
      ></circle>
    </svg>
  </div>

  <div class="hero__corners" aria-hidden="true">
    <span class="hero__corner hero__corner--tl">
      <span class="hero__corner-num">/ 00</span>
      <span class="hero__corner-rule"></span>
      <span>cover</span>
    </span>
    <span class="hero__corner hero__corner--tr">
      <span class="hero__corner-num">61° N · 24° E</span>
      <span class="hero__corner-rule hero__corner-rule--tr"></span>
      <span class="hero__corner-place">tampere · hervanta</span>
    </span>
  </div>
</section>

<style>
  /* The hero paints NO background of its own: the whole page sits on one
     flat var(--color-ink) (body) with the fixed particle-field canvas
     behind every section, so there is no hero→About colour boundary to
     blend — the old radial gradient + bottom fade are gone because the
     seam they papered over no longer exists. The atmospheric centre glow
     they provided now lives inside the field scene (a glow plate that
     fades out as the field dissolves to starfield). */
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: transparent;
  }

  /* On the desktop default path this container has no visible children
     (the only visible content lives in .hero__masthead at the top of the
     hero, on the 3D canvas behind, and in .hero__scroll-hint at the bottom).
     It still hosts .hero__title-fallback for the mobile / reduced-motion
     paths where the 3D type can't render — those paths use the flex-column
     centering below to drop the fallback text into the middle of the hero. */
  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 14vh;
    pointer-events: none;
    text-align: center;
  }

  /* Masthead — eyebrow + subtitle paired at the top of the hero like a
     magazine cover's banner. Subtitle used to sit in the centred flex
     column below the 3D type and visually collided with the "NUMMINEN"
     word; pairing it with the eyebrow keeps the cover information in
     one block and frees the centre for the type alone. */
  .hero__masthead {
    position: absolute;
    top: 7.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    /* An absolutely positioned box with `left: 50%` and no `right` gets a
       shrink-to-fit width capped at the space to its right, which is half the
       hero. At 360px that is 180px, and the subtitle wrapped to four lines
       inside it while looking correct on every desktop width. `max-content`
       takes the natural width instead; the cap keeps it off the edges. */
    width: max-content;
    max-width: calc(100% - 3rem);
  }

  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__title-fallback {
    font-size: clamp(3rem, 13vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    margin: 0;
    line-height: 0.92;
    text-shadow:
      0 0 40px rgba(80, 130, 255, 0.18),
      0 8px 40px rgba(0, 0, 0, 0.6);
    /* Hidden by default — only shown on mobile / reduced motion / when JS is off */
    display: none;
  }

  @media (max-width: 640px) {
    .hero__title-fallback {
      display: block;
    }

    /* Phones are the one place the masthead and the centred fallback title
       compete for the same band: the title is real DOM here rather than
       particles, and it centres at 43vh because .hero__content reserves 14vh
       at the bottom. At 360x640 the gap between them was already down to 10px
       before the masthead grew a third line, so the block moves up to take it
       back. 6rem still clears the nav, which ends at 52px. */
    .hero__masthead {
      top: 6rem;
    }

    /* The pill and the read link have to share one line here. Together they
       need 311px against a 297px cap at 360px wide, so the row wrapped and
       took 47px of the clearance this block exists to protect, putting the
       masthead 21px INTO the fallback title.
       The size is the part that goes: it is decorative markup
       (`aria-hidden`), the accessible name still announces it, and dropping it
       leaves 51px of slack instead of 6px, which is the difference between a
       fix and a fix that breaks on the next font change. */
    .hero__cv-size {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-fallback {
      display: block;
    }
  }

  .hero__subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.4vw, 0.95rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  /* The research page's hairline download pill, restyled into the home
     register. Same shape on purpose: it is the site's only established
     "this downloads a PDF" affordance, so a returning visitor has already
     learned it. Accent blue rather than the terminal's green, because
     #c4d4ff is what a link looks like everywhere else here and the green
     belongs to the contact terminal. */
  /* Wraps only if the two controls genuinely cannot share a line, which at the
     narrowest supported width they can: the pill is about 94px and the read
     link about 120px inside a 312px cap. */
  .hero__cv-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .hero__cv {
    /* No margin-top: the parent's `gap` already spaces flex children, and the
       two do not collapse, so a margin here is added to the gap rather than
       replacing it. */
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(196, 212, 255, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    text-decoration: none;
    color: rgba(196, 212, 255, 0.9);
    background: rgba(196, 212, 255, 0.04);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .hero__cv:hover,
  .hero__cv:focus-visible {
    border-color: rgba(196, 212, 255, 0.85);
    background: rgba(196, 212, 255, 0.1);
    color: #fff;
  }

  /* Quieter than the label, matching how the corner markers rank their
     numerals below their words, but only as quiet as WCAG AA allows. The
     corner markers get to sit at 0.3 because they are decorative frame
     ornaments; a file size on a download control is information someone uses
     to decide whether to click, so it is held to 4.5:1. Measured against the
     composited pill fill: 0.45 was 3.4:1, 0.65 is 5.9:1.

     `text-transform` is reset because the pill lowercases its label, and the
     unit is not a word: lowercased, "54 KB" becomes "54 kb", which reads as
     kilobits and disagrees with the research pill this one is modelled on. */
  .hero__cv-size {
    color: rgba(196, 212, 255, 0.65);
    letter-spacing: 0.1em;
    text-transform: none;
  }

  /* Ranked below the pill: reading is the alternative, downloading is what
     most visitors came for. Underlined rather than bordered so it does not
     read as a second button competing with the first.

     The vertical padding brings the hit box to the pill's height, which keeps
     it over the 24px floor in WCAG 2.2 SC 2.5.8 and costs the masthead no
     extra height, since the row is already as tall as the pill. */
  .hero__cv-read {
    padding: 0.5rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    transition:
      color 0.3s ease,
      text-decoration-color 0.3s ease;
  }

  .hero__cv-read:hover,
  .hero__cv-read:focus-visible {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.8);
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  .hero__scroll-circle {
    animation: hero-scroll-bob 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-circle {
      animation: none;
    }
  }

  /* Editorial corner markers — frame the hero like a magazine cover.
     Hidden on small screens where the eyebrow already does this work. */
  .hero__corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero__corner {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.4rem 0;
  }

  .hero__corner-num {
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.14em;
  }

  /* Quieter than .hero__corner-num so the place reads as a hidden detail
     rather than a label competing with the coords. Also slightly smaller
     so the coords stay primary and the place reads as a caption. */
  .hero__corner-place {
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.22em;
    font-size: 0.58rem;
  }

  /* Short horizontal accent between the coords and the place when stacked
     vertically — gives the corner an editorial tag feel instead of just
     two lines of text. */
  .hero__corner-rule--tr {
    width: 1.5rem;
    margin: 0.1rem 0;
    opacity: 0.35;
  }

  .hero__corner-rule {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  /* Aligned with the centered .hero__masthead at top:7.5rem so the three
     labels (corner-left · eyebrow · corner-right) sit on a single
     editorial axis. */
  .hero__corner--tl {
    top: 7.5rem;
    left: 2rem;
  }

  .hero__corner--tr {
    top: 7.5rem;
    right: 2rem;
    /* Stack the coords above the place label, right-aligned, with a short
       horizontal accent between them. */
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  @media (max-width: 860px) {
    .hero__corners {
      display: none;
    }
  }

  /* Short landscape viewports — the 3D type centres in 100vh and on a
     short window its top edge climbs up into the masthead band (and the
     top corner markers), causing the eyebrow + subtitle to overlap the
     letters. Pull the top chrome up to ~1.5rem so the centre is free for
     the type. Scoped to landscape orientation specifically so the rule
     doesn't fire on a tall narrow phone in portrait, where the masthead
     position is already fine. The 7.5rem default looks correct on tall
     viewports; this compensates only when vertical room is tight. */
  @media (max-height: 600px) and (orientation: landscape) {
    .hero__masthead,
    .hero__corner--tl,
    .hero__corner--tr {
      top: 1.5rem;
    }
  }
</style>
