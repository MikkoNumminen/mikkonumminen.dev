---
import { asLocale, getTranslations } from '../../i18n';
import HeroVoiceover from './HeroVoiceover.astro';

interface Props {
  commitMessages?: string[];
}

const { commitMessages = [] } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<section class="hero" data-section-hero aria-label={t.hero.sectionAria}>
  <HeroVoiceover />

  <canvas
    id="home-canvas"
    class="hero__canvas"
    aria-hidden="true"
    data-commit-messages={JSON.stringify(commitMessages)}></canvas>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__fade" aria-hidden="true"></div>

  <div class="hero__masthead">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
  </div>

  <div class="hero__content">
    <h1 class="hero__title sr-only">{t.hero.titleSrOnly}</h1>

    <p class="hero__title-fallback" data-fallback>
      {t.hero.titleFallbackTop}<br />{t.hero.titleFallbackBottom}
    </p>
  </div>

  <div class="hero__scroll-hint" data-scroll-hint aria-hidden="true">
    <span>{t.hero.scrollHint}</span>
    <svg
      width="14"
      height="22"
      viewBox="0 0 14 22"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="0.5" y="0.5" width="13" height="21" rx="6.5" stroke="currentColor"></rect>
      <circle cx="7" cy="7" r="1.5" fill="currentColor" class="hero__scroll-circle"
      ></circle>
    </svg>
  </div>

  <div class="hero__corners" aria-hidden="true">
    <span class="hero__corner hero__corner--tl">
      <span class="hero__corner-num">/ 00</span>
      <span class="hero__corner-rule"></span>
      <span>cover</span>
    </span>
    <span class="hero__corner hero__corner--tr">
      <span class="hero__corner-num">61° N · 24° E</span>
      <span class="hero__corner-rule hero__corner-rule--tr"></span>
      <span class="hero__corner-place">tampere · hervanta</span>
    </span>
    <span class="hero__data-feed" data-data-feed>
      <span class="hero__data-feed-label">
        <span class="hero__data-feed-pulse"></span>
        <span>data · ch-01</span>
      </span>
      <canvas class="hero__data-feed-canvas" width="480" height="144" aria-hidden="true"
      ></canvas>
    </span>
    <span class="hero__corner hero__corner--br">
      <span class="hero__corner-num">vol. 26</span>
    </span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: radial-gradient(
      ellipse at 50% 30%,
      #0d1226 0%,
      #050610 60%,
      #020308 100%
    );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* On mobile and reduced-motion the chrome 3D type is replaced by the
     flat `.hero__title-fallback`. The canvas was still rendering behind
     the fallback in those cases, producing a small blue 3D wordmark
     stacked above the white fallback — visible from ≤640px down to the
     narrowest viewports. Hide the canvas wherever the fallback takes
     over so only one title shows at a time. */
  @media (max-width: 640px) {
    .hero__canvas {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__canvas {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 40%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  /* The hero is the only section that paints its own opaque background;
     every section below it is transparent over var(--color-ink). Fade the
     hero's bottom into that same colour so the hero→next boundary is
     colour-to-colour like every other boundary, not a hard edge. Ordered
     after the canvas/vignette but before the masthead/scroll chrome, so it
     blends the backdrop without dimming any foreground. */
  .hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent 0%, var(--color-ink) 100%);
    pointer-events: none;
  }

  /* On the desktop default path this container has no visible children
     (the only visible content lives in .hero__masthead at the top of the
     hero, on the 3D canvas behind, and in .hero__scroll-hint at the bottom).
     It still hosts .hero__title-fallback for the mobile / reduced-motion
     paths where the 3D type can't render — those paths use the flex-column
     centering below to drop the fallback text into the middle of the hero. */
  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 14vh;
    pointer-events: none;
    text-align: center;
  }

  /* Masthead — eyebrow + subtitle paired at the top of the hero like a
     magazine cover's banner. Subtitle used to sit in the centred flex
     column below the 3D type and visually collided with the "NUMMINEN"
     word; pairing it with the eyebrow keeps the cover information in
     one block and frees the centre for the type alone. */
  .hero__masthead {
    position: absolute;
    top: 7.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__title-fallback {
    font-size: clamp(3rem, 13vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    margin: 0;
    line-height: 0.92;
    text-shadow:
      0 0 40px rgba(80, 130, 255, 0.18),
      0 8px 40px rgba(0, 0, 0, 0.6);
    /* Hidden by default — only shown on mobile / reduced motion / when JS is off */
    display: none;
  }

  @media (max-width: 640px) {
    .hero__title-fallback {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-fallback {
      display: block;
    }
  }

  .hero__subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.4vw, 0.95rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  .hero__scroll-circle {
    animation: hero-scroll-bob 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-circle {
      animation: none;
    }
  }

  /* Editorial corner markers — frame the hero like a magazine cover.
     Hidden on small screens where the eyebrow already does this work. */
  .hero__corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero__corner {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.4rem 0;
  }

  .hero__corner-num {
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.14em;
  }

  /* Quieter than .hero__corner-num so the place reads as a hidden detail
     rather than a label competing with the coords. Also slightly smaller
     so the coords stay primary and the place reads as a caption. */
  .hero__corner-place {
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.22em;
    font-size: 0.58rem;
  }

  /* Short horizontal accent between the coords and the place when stacked
     vertically — gives the corner an editorial tag feel instead of just
     two lines of text. */
  .hero__corner-rule--tr {
    width: 1.5rem;
    margin: 0.1rem 0;
    opacity: 0.35;
  }

  .hero__corner-rule {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  /* Aligned with the centered .hero__masthead at top:7.5rem so the three
     labels (corner-left · eyebrow · corner-right) sit on a single
     editorial axis. */
  .hero__corner--tl {
    top: 7.5rem;
    left: 2rem;
  }

  .hero__corner--tr {
    top: 7.5rem;
    right: 2rem;
    /* Stack the coords above the place label, right-aligned, with a short
       horizontal accent between them. */
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .hero__corner--br {
    bottom: 2.5rem;
    right: 2rem;
  }

  @media (max-width: 860px) {
    .hero__corners {
      display: none;
    }
  }

  /* Short landscape viewports — the 3D type centres in 100vh and on a
     short window its top edge climbs up into the masthead band (and the
     top corner markers), causing the eyebrow + subtitle to overlap the
     letters. Pull the top chrome up to ~1.5rem so the centre is free for
     the type. Scoped to landscape orientation specifically so the rule
     doesn't fire on a tall narrow phone in portrait, where the masthead
     position is already fine. The 7.5rem default looks correct on tall
     viewports; this compensates only when vertical room is tight. */
  @media (max-height: 600px) and (orientation: landscape) {
    .hero__masthead,
    .hero__corner--tl,
    .hero__corner--tr {
      top: 1.5rem;
    }
  }

  /* Live data-feed widget. The cyan pulse + cascading glyphs read as
     "this location is where data flows". Re-anchored to bottom-right so
     it lives below the title's vertical band — no horizontal conflict
     with the right-third chrome wordmark on any viewport. Sits just
     above the "vol. 26" corner label, sharing the same right edge. */
  .hero__data-feed {
    position: absolute;
    bottom: 5.25rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    /* Discoverability — the widget is one of the click-to-animate
       elements (alongside the 3D type and the galaxy). Per the
       Mixed-cursor choice from the senior-designer review, the big
       elements get a pointer cursor; the small Easter-egg ones (goat,
       ring, star) stay hidden. */
    cursor: pointer;
    /* `.hero__corners` (this element's parent) sets `pointer-events:
       none` so the chrome doesn't intercept canvas clicks. That value
       propagates to descendants, so without re-enabling it here the
       widget would be visually clickable (cursor + cursor: pointer)
       but the `pointerdown` handler in the script below would never
       fire and the click-to-animate ping line would silently drop. */
    pointer-events: auto;
  }

  .hero__data-feed-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(180, 220, 255, 0.55);
  }

  .hero__data-feed-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6fcfe0;
    box-shadow: 0 0 6px rgba(111, 207, 224, 0.65);
    animation: hero-data-feed-pulse 1.6s ease-in-out infinite;
  }

  @keyframes hero-data-feed-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  .hero__data-feed-canvas {
    width: 14rem;
    height: 4.4rem;
    display: block;
    border-bottom: 1px solid rgba(111, 207, 224, 0.18);
    /* Soft fade on the left so the cascade doesn't read as a hard
       rectangle dropped onto the page. */
    mask-image: linear-gradient(to right, transparent, black 18%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent, black 18%, black 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__data-feed-pulse {
      animation: none;
    }
  }
</style>

<script>
  import { buildDataFeedConsole } from '../../lib/home/dataFeedConsole';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const init = (): void => {
    // Corner widgets are hidden via CSS at ≤860px; skip the console
    // work on mobile so we don't burn CPU painting an invisible canvas.
    if (window.matchMedia('(max-width: 860px)').matches) return;
    const root = document.querySelector<HTMLElement>('[data-data-feed]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('.hero__data-feed-canvas');
    if (!canvas) return;
    const handle = buildDataFeedConsole(canvas, reducedMotion);

    // Click-to-animate: clicking the widget injects a "ping" exchange
    // into the typing queue. Mirrors the click responses on the scene
    // elements — each clickable corner of the hero acknowledges the user.
    // Uses `pointerdown` (not `click`) to match the 3D scene's snappy
    // press-to-fire feel; otherwise the data-feed would lag behind a
    // letter pop in side-by-side comparison. Reduced-motion clients get
    // the no-op handle from buildDataFeedConsole, so pushLine is a no-op
    // there.
    const onPointerDown = (): void => {
      handle.pushLine(
        { text: '$ ping mikko', kind: 'cmd' },
        { text: '> hi 0.01ms', kind: 'out' },
      );
    };
    root.addEventListener('pointerdown', onPointerDown);

    window.addEventListener(
      'beforeunload',
      () => {
        root.removeEventListener('pointerdown', onPointerDown);
        handle.dispose();
      },
      { once: true },
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
