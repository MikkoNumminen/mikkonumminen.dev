---
import { asLocale, getTranslations } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<section class="hero" data-section-hero aria-label={t.hero.sectionAria}>
  <canvas id="home-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>

    <h1 class="hero__title sr-only">{t.hero.titleSrOnly}</h1>

    <p class="hero__title-fallback" data-fallback>
      {t.hero.titleFallbackTop}<br />{t.hero.titleFallbackBottom}
    </p>

    <p class="hero__subtitle">
      {t.hero.subtitle}
    </p>
  </div>

  <div class="hero__scroll-hint" data-scroll-hint aria-hidden="true">
    <span>{t.hero.scrollHint}</span>
    <svg
      width="14"
      height="22"
      viewBox="0 0 14 22"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="0.5" y="0.5" width="13" height="21" rx="6.5" stroke="currentColor"></rect>
      <circle cx="7" cy="7" r="1.5" fill="currentColor" class="hero__scroll-circle"
      ></circle>
    </svg>
  </div>

  <div class="hero__corners" aria-hidden="true">
    <span class="hero__corner hero__corner--tl">
      <span class="hero__corner-num">/ 00</span>
      <span class="hero__corner-rule"></span>
      <span>cover</span>
    </span>
    <span class="hero__corner hero__corner--tr">
      <span class="hero__corner-num">61° N · 24° E</span>
      <span class="hero__corner-rule hero__corner-rule--tr"></span>
      <span class="hero__corner-place">tampere · hervanta</span>
      <div class="hero__data-feed" data-data-feed>
        <span class="hero__data-feed-label">
          <span class="hero__data-feed-pulse"></span>
          <span>data · ch-01</span>
        </span>
        <canvas
          class="hero__data-feed-canvas"
          width="480"
          height="144"
          aria-hidden="true"></canvas>
      </div>
    </span>
    <span class="hero__corner hero__corner--br">
      <span class="hero__corner-num">vol. 26</span>
    </span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: radial-gradient(
      ellipse at 50% 30%,
      #0d1226 0%,
      #050610 60%,
      #020308 100%
    );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 40%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 14vh;
    pointer-events: none;
    text-align: center;
    gap: 2rem;
  }

  .hero__eyebrow {
    position: absolute;
    top: 7.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__title-fallback {
    font-size: clamp(3rem, 13vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    margin: 0;
    line-height: 0.92;
    text-shadow:
      0 0 40px rgba(80, 130, 255, 0.18),
      0 8px 40px rgba(0, 0, 0, 0.6);
    /* Hidden by default — only shown on mobile / reduced motion / when JS is off */
    display: none;
  }

  @media (max-width: 640px) {
    .hero__title-fallback {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-fallback {
      display: block;
    }
  }

  .hero__subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.4vw, 0.95rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  .hero__scroll-circle {
    animation: hero-scroll-bob 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-circle {
      animation: none;
    }
  }

  /* Editorial corner markers — frame the hero like a magazine cover.
     Hidden on small screens where the eyebrow already does this work. */
  .hero__corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero__corner {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.4rem 0;
  }

  .hero__corner-num {
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.14em;
  }

  /* Quieter than .hero__corner-num so the place reads as a hidden detail
     rather than a label competing with the coords. Also slightly smaller
     so the coords stay primary and the place reads as a caption. */
  .hero__corner-place {
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.22em;
    font-size: 0.58rem;
  }

  /* Short horizontal accent between the coords and the place when stacked
     vertically — gives the corner an editorial tag feel instead of just
     two lines of text. */
  .hero__corner-rule--tr {
    width: 1.5rem;
    margin: 0.1rem 0;
    opacity: 0.35;
  }

  .hero__corner-rule {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  /* Aligned with the centered .hero__eyebrow at top:7.5rem so the three
     labels (corner-left · eyebrow · corner-right) sit on a single
     editorial axis. */
  .hero__corner--tl {
    top: 7.5rem;
    left: 2rem;
  }

  .hero__corner--tr {
    top: 7.5rem;
    right: 2rem;
    /* Stack the coords above the place label, right-aligned, with a short
       horizontal accent between them. */
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .hero__corner--br {
    bottom: 2.5rem;
    right: 2rem;
  }

  @media (max-width: 860px) {
    .hero__corners {
      display: none;
    }
  }

  /* Live data-feed widget tucked under the editorial coords. The cyan
     pulse + cascading glyphs read as "this location is where data
     flows" — the corner is no longer just static labels. */
  .hero__data-feed {
    margin-top: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .hero__data-feed-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(180, 220, 255, 0.55);
  }

  .hero__data-feed-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6fcfe0;
    box-shadow: 0 0 6px rgba(111, 207, 224, 0.65);
    animation: hero-data-feed-pulse 1.6s ease-in-out infinite;
  }

  @keyframes hero-data-feed-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  .hero__data-feed-canvas {
    width: 14rem;
    height: 4.4rem;
    display: block;
    border-bottom: 1px solid rgba(111, 207, 224, 0.18);
    /* Soft fade on the left so the cascade doesn't read as a hard
       rectangle dropped onto the page. */
    mask-image: linear-gradient(to right, transparent, black 18%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent, black 18%, black 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__data-feed-pulse {
      animation: none;
    }
  }
</style>

<script>
  import { buildDataFeedMatrix } from '../../lib/home/dataFeedMatrix';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const init = (): void => {
    const root = document.querySelector<HTMLElement>('[data-data-feed]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('.hero__data-feed-canvas');
    if (!canvas) return;
    const handle = buildDataFeedMatrix(canvas, reducedMotion);
    window.addEventListener('beforeunload', () => handle.dispose(), { once: true });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
