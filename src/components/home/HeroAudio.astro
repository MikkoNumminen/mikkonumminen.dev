---
// Background music for the home / lander screen. Plays only on this page —
// `<audio>` is part of the home document, so any navigation tears it down
// naturally.
//
// Behaviour:
// - Tries to start playing on load. Modern browsers will silently block
//   autoplay without a prior user gesture; the script catches that and
//   waits for the first pointer/keyboard event to retry, so the button
//   reflects the actual playing/paused state.
// - Volume modulates with scroll position. While the hero section is in
//   view the track plays at its full level; as the user scrolls past, the
//   volume eases down to a quieter "background" level so the lower
//   sections aren't drowned out.
// - Choice (on / off) is remembered in sessionStorage so reloading the
//   home page in the same tab preserves the user's preference.
---

<div class="hero-audio" data-state="loading">
  <audio
    id="hero-audio"
    preload="auto"
    loop
    playsinline
    aria-hidden="true"
  >
    <source src="/audio/devlander.ogg" type="audio/ogg" />
    <source src="/audio/devlander.mp3" type="audio/mpeg" />
  </audio>

  <button
    type="button"
    class="hero-audio__toggle"
    aria-pressed="false"
    aria-label="Toggle background music"
    data-hero-audio-toggle
  >
    <span class="hero-audio__icon" aria-hidden="true">
      <svg
        class="hero-audio__svg hero-audio__svg--on"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 9h3.5L13 5v14L7.5 15H4z"></path>
        <path class="hero-audio__wave hero-audio__wave--near" d="M16 9.2a4 4 0 0 1 0 5.6"></path>
        <path class="hero-audio__wave hero-audio__wave--far" d="M18.5 6.7a7 7 0 0 1 0 10.6"></path>
      </svg>
      <svg
        class="hero-audio__svg hero-audio__svg--off"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 9h3.5L13 5v14L7.5 15H4z"></path>
        <path d="M16 9l5 6"></path>
        <path d="M21 9l-5 6"></path>
      </svg>
    </span>
    <span class="hero-audio__label">
      <span class="hero-audio__label-on">sound on</span>
      <span class="hero-audio__label-off">sound off</span>
    </span>
  </button>
</div>

<style>
  /* Fixed-position floating control. Lives in the bottom-left corner so
     it doesn't fight the bottom-right data-feed widget or the centered
     scroll hint above it. Stays visible while the user is on the home
     page — the audio plays through every section so the mute control
     must remain reachable. */
  .hero-audio {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 40;
    pointer-events: auto;
  }

  .hero-audio__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 1rem 0.55rem 0.7rem;
    border: 1px solid rgba(103, 232, 249, 0.3);
    border-radius: 999px;
    background: rgba(8, 14, 22, 0.65);
    color: rgba(196, 212, 255, 0.85);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-audio__toggle:hover,
  .hero-audio__toggle:focus-visible {
    border-color: rgba(103, 232, 249, 0.55);
    color: #fff;
    transform: translateY(-1px);
    outline: none;
  }

  .hero-audio__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    color: rgba(103, 232, 249, 0.9);
    transition: color 0.3s ease;
  }

  .hero-audio__toggle:hover .hero-audio__icon {
    color: #67e8f9;
  }

  /* Only one of the two SVGs is shown at a time. Default DOM order shows
     "on" — the script flips `[data-state]` on the wrapper to pick. */
  .hero-audio__svg {
    width: 100%;
    height: 100%;
  }

  .hero-audio[data-state='on'] .hero-audio__svg--off,
  .hero-audio[data-state='loading'] .hero-audio__svg--off,
  .hero-audio[data-state='off'] .hero-audio__svg--on {
    display: none;
  }

  /* Sound-wave arcs gently expand while the track is playing so the
     control hints at the audio state without being distracting. */
  .hero-audio__wave {
    transform-origin: 14px 12px;
    transform-box: fill-box;
    opacity: 0.85;
  }

  .hero-audio[data-state='on'] .hero-audio__wave--near {
    animation: hero-audio-wave 2.4s ease-in-out infinite;
  }
  .hero-audio[data-state='on'] .hero-audio__wave--far {
    animation: hero-audio-wave 2.4s ease-in-out infinite 0.6s;
  }

  @keyframes hero-audio-wave {
    0%, 100% {
      opacity: 0.4;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  .hero-audio__label {
    position: relative;
    display: inline-block;
    min-width: 4.5em;
    line-height: 1;
  }

  .hero-audio__label-on,
  .hero-audio__label-off {
    display: inline-block;
  }

  .hero-audio[data-state='off'] .hero-audio__label-on,
  .hero-audio[data-state='on'] .hero-audio__label-off,
  .hero-audio[data-state='loading'] .hero-audio__label-off {
    display: none;
  }

  /* Loading state — show the "on" label/icon dimly until the script
     resolves the actual playing state on the first frame. */
  .hero-audio[data-state='loading'] .hero-audio__toggle {
    color: rgba(196, 212, 255, 0.55);
  }
  .hero-audio[data-state='loading'] .hero-audio__icon {
    color: rgba(103, 232, 249, 0.5);
  }

  @media (max-width: 640px) {
    .hero-audio {
      bottom: 1.25rem;
      left: 1.25rem;
    }
    .hero-audio__toggle {
      padding: 0.5rem 0.85rem 0.5rem 0.65rem;
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-audio__toggle,
    .hero-audio__toggle:hover,
    .hero-audio__toggle:focus-visible {
      transform: none;
    }
    .hero-audio[data-state='on'] .hero-audio__wave--near,
    .hero-audio[data-state='on'] .hero-audio__wave--far {
      animation: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'mn_hero_audio_off';
  // Hero / scrolled-past volume targets. Linear-interpolated by scroll
  // progress so the music eases down as the user leaves the hero behind.
  const HERO_VOLUME = 0.85;
  const SCROLLED_VOLUME = 0.35;

  const wrapper = document.querySelector<HTMLElement>('.hero-audio');
  const audio = document.getElementById('hero-audio') as HTMLAudioElement | null;
  const button = document.querySelector<HTMLButtonElement>('[data-hero-audio-toggle]');
  const hero = document.querySelector<HTMLElement>('[data-section-hero]');

  if (wrapper && audio && button) {
    let userWantsOff = false;
    try {
      userWantsOff = sessionStorage.getItem(STORAGE_KEY) === '1';
    } catch {
      /* sessionStorage may be unavailable; default to wanting on */
    }

    const setState = (state: 'on' | 'off'): void => {
      wrapper.dataset.state = state;
      button.setAttribute('aria-pressed', state === 'on' ? 'true' : 'false');
    };

    const remember = (off: boolean): void => {
      try {
        if (off) sessionStorage.setItem(STORAGE_KEY, '1');
        else sessionStorage.removeItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
    };

    // Compute the volume the track *should* be at right now, given the
    // user's scroll position. 0-progress = hero fully visible, 1-progress
    // = hero fully scrolled past. We don't lerp below the floor so the
    // music never silently turns off from scrolling alone.
    const computeVolume = (): number => {
      if (!hero) return HERO_VOLUME;
      const rect = hero.getBoundingClientRect();
      const heroH = rect.height || 1;
      const progress = Math.max(0, Math.min(1, -rect.top / heroH));
      return HERO_VOLUME + (SCROLLED_VOLUME - HERO_VOLUME) * progress;
    };

    audio.volume = computeVolume();

    const tryPlay = async (): Promise<boolean> => {
      try {
        await audio.play();
        setState('on');
        return true;
      } catch {
        // Most likely the browser blocked autoplay because there hasn't
        // been a user gesture yet. Leave the button in `off` state and
        // wait for the first interaction; the gesture listener below
        // will retry.
        setState('off');
        return false;
      }
    };

    button.addEventListener('click', async () => {
      if (audio.paused) {
        const started = await tryPlay();
        if (started) remember(false);
      } else {
        audio.pause();
        setState('off');
        remember(true);
      }
    });

    // First-interaction fallback. If the user wants audio on but the
    // browser blocked the initial autoplay, the next pointer/keyboard
    // event the page sees becomes the gesture that unlocks it.
    const unlock = (): void => {
      document.removeEventListener('pointerdown', unlock);
      document.removeEventListener('keydown', unlock);
      if (audio.paused && !userWantsOff) {
        tryPlay();
      }
    };
    document.addEventListener('pointerdown', unlock, { once: true });
    document.addEventListener('keydown', unlock, { once: true });

    // Scroll-driven volume. Only mutates volume while the track is
    // actually playing — keeps the call cheap and avoids fighting a
    // user-paused state.
    let ticking = false;
    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (!audio.paused) audio.volume = computeVolume();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Initial play attempt. The script may run after the page is
    // already loaded (Astro inline scripts execute after the DOM is
    // parsed), so we don't need to wait for DOMContentLoaded.
    if (!userWantsOff) {
      tryPlay();
    } else {
      setState('off');
    }
  }
</script>
