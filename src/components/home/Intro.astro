---
import { asLocale, getTranslations } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<section class="intro has-grain" aria-label={t.intro.sectionAria}>
  <span class="ghost-num intro__ghost" aria-hidden="true">01</span>

  <div class="intro__inner">
    <p class="intro__eyebrow eyebrow-marker" data-reveal>
      <span class="eyebrow-marker__num" aria-hidden="true">/ 01</span>
      <span class="eyebrow-marker__rule" aria-hidden="true"></span>
      {t.intro.eyebrow}
    </p>

    <h2 class="intro__heading">
      <span data-split data-reveal-chars>{t.intro.heading}</span>
    </h2>

    <!-- Delete this marker and t.intro.placeholderNote together once the real
         paragraph is written. -->
    <p class="intro__placeholder" data-reveal>{t.intro.placeholderNote}</p>

    <p class="intro__body" data-reveal>
      {t.intro.body}
    </p>
  </div>
</section>

<style>
  .intro {
    position: relative;
    padding: clamp(8rem, 18vh, 14rem) 1.5rem clamp(6rem, 12vh, 9rem);
    overflow: hidden;
  }

  .intro__ghost {
    top: 4rem;
    right: -2vw;
  }

  .intro__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
  }

  .intro__eyebrow {
    margin: 0;
  }

  .intro__heading {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    /* 1.18, not the editorial-tight 1.02, so descenders aren't clipped by
       the [data-split] inline-block's overflow:hidden and so longer
       FI/SV translations have room to wrap without lines colliding. */
    line-height: 1.18;
    font-weight: 700;
    letter-spacing: -0.035em;
    margin: 0;
    color: #fff;
    max-width: 18ch;
  }

  .intro__placeholder {
    justify-self: start;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border: 1px dashed rgba(251, 191, 36, 0.65);
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.08);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fbbf24;
  }

  .intro__body {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    max-width: 62ch;
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px dashed rgba(251, 191, 36, 0.45);
  }

  @media (max-width: 720px) {
    .intro__ghost {
      top: 2rem;
      right: -4vw;
      font-size: clamp(7rem, 28vw, 12rem);
    }
  }
</style>
