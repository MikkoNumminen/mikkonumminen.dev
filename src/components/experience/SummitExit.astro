---
/**
 * The top of the page: the exit to the terminal.
 *
 * This used to sit inside the summit block, halfway up the document, which
 * meant a reader who only came for the tech stack reached the stack and then
 * had nowhere to go. Lifting it to the very top gives the climb an ending —
 * the last thing above the summit and the stack is the way to get in touch —
 * and it is reached naturally whichever route the reader took.
 *
 * PARALLEL TO the CTA styling in `experience-timeline.css`; the classes are
 * shared with the summit block that used to own this, so a change to one is a
 * change to both.
 */
import { asLocale, getTranslations, localizePath } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<div class="summit-exit" id="summit-exit">
  <a href={localizePath('/contact', locale)} class="timeline__cta">
    <span class="timeline__cta-glow" aria-hidden="true"></span>
    <span class="timeline__cta-text">{t.experiencePage.cta}</span>
  </a>
</div>

<style>
  .summit-exit {
    display: flex;
    justify-content: center;
    /* Clears the fixed nav pill, which overlays the top of the document. */
    padding: 7rem 1rem 2.5rem;
  }
</style>
