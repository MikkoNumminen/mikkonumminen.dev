---
import { donutArcs, DONUT_RADIUS, languageMix } from '../../data/projectLanguages';
import { asLocale, getTranslations } from '../../i18n';

const t = getTranslations(asLocale(Astro.currentLocale));
const slices = languageMix();

/*
 * Hand-rolled SVG rather than a chart library, and that is the whole decision.
 *
 * A charting package means React on a site that has none: Astro islands, vanilla
 * TypeScript, Three.js and GSAP, and nothing else. Pulling a framework and a
 * renderer in for one donut of six slices would be the largest dependency on the
 * page by an order of magnitude, and it would ship to every visitor who loads the
 * experience view.
 *
 * The maths is one line of trigonometry per slice. `stroke-dasharray` on a circle
 * draws an arc; rotating each one by the running total lays them end to end. No
 * paths to compute, no layout engine, nothing to hydrate.
 */

// Fixed palette rather than generated hues: the site accent family is
// blue/green and a generated wheel would wander into the amber the AI badge
// owns. Longer than the current six languages, because the allowlist holds
// sixteen and a seventh language appearing would otherwise reuse a colour.
const COLOURS = [
  '#4ade80',
  '#38bdf8',
  '#a78bfa',
  '#f472b6',
  '#fbbf24',
  '#2dd4bf',
  '#fb7185',
  '#c084fc',
];

const arcs = donutArcs(slices).map((arc, i) => ({
  ...arc,
  colour: COLOURS[i % COLOURS.length],
}));
---

{
  slices.length > 0 && (
    <figure class="lang-mix">
      <figcaption class="lang-mix__caption">
        {t.experiencePage.languageMixTitle}
        {/* The metric, said out loud. "Projects per language" and "share of the
            codebase" are different claims, and the second one is the one a
            reader assumes a donut is making. */}
        <span class="lang-mix__note">{t.experiencePage.languageMixNote}</span>
      </figcaption>

      <div class="lang-mix__body">
        {/* Decoration, not content. The legend below is the same data as real
            text, so labelling the donut too would announce every language twice.
            Same reasoning as AiBadge's `decorative` prop, which exists because
            the card already carries that fact in the link name. */}
        <svg class="lang-mix__chart" viewBox="0 0 130 130" aria-hidden="true">
          {arcs.map((arc) => (
            <circle
              class="lang-mix__arc"
              cx="65"
              cy="65"
              r={DONUT_RADIUS}
              fill="none"
              stroke={arc.colour}
              stroke-width="16"
              stroke-dasharray={arc.dash}
              transform={`rotate(${arc.rotation} 65 65)`}
            />
          ))}
        </svg>

        <ul class="lang-mix__legend">
          {arcs.map((arc) => (
            <li class="lang-mix__item">
              <span
                class="lang-mix__swatch"
                style={`background:${arc.colour}`}
                aria-hidden="true"
              />
              <span class="lang-mix__name">{arc.language}</span>
              <span class="lang-mix__count">{arc.count}</span>
            </li>
          ))}
        </ul>
      </div>
    </figure>
  )
}

<style>
  .lang-mix {
    margin: 1.75rem 0 0;
  }

  .lang-mix__caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1rem;
  }

  .lang-mix__note {
    letter-spacing: 0.08em;
    text-transform: none;
    color: rgba(255, 255, 255, 0.4);
  }

  .lang-mix__body {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .lang-mix__chart {
    width: 130px;
    height: 130px;
    flex: none;
  }

  /* The arcs are the data. Nothing animates: this sits inside a view that
     already runs a GSAP timeline and a Three.js scene, and one more moving thing
     is noise rather than information. */
  .lang-mix__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.35rem 1.25rem;
    flex: 1 1 12rem;
  }

  .lang-mix__item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .lang-mix__swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    flex: none;
  }

  .lang-mix__name {
    flex: 1;
  }

  .lang-mix__count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
