---
/**
 * The technology box that closes `/experience`.
 *
 * Built on `<details>`/`<summary>` rather than a button and a script. That is
 * not minimalism for its own sake: the native element already answers every
 * requirement here — Enter and Space toggle it, the open state is exposed to
 * assistive technology without an `aria-expanded` I would have to keep in sync,
 * and a tap is just a click. Reaching for JavaScript would have meant
 * reimplementing all of it slightly worse.
 *
 * Primaries with nothing underneath render as a paragraph, not an inert
 * summary, so a keyboard user never tabs to something that does not respond.
 */
import { techStack, type TechContext } from '../../data/techStack';
import { techProjects } from '../../data/techProjects';
import { projects } from '../../data/projects';
import { asLocale, getTranslations } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
const copy = t.techStack;
/** `work` and `both` both mean it was used in client work; the badge says so. */
const wearsBadge = (context?: TechContext): boolean =>
  context === 'work' || context === 'both';

// The project view is a pivot of the same curated list, not a second list.
// Ordering follows `techStack`, so a technology sits in the same relative
// place whichever way the box is read.
const techOrder = new Map(
  techStack
    .flatMap((c) => c.primaries.flatMap((pr) => [pr, ...(pr.secondaries ?? [])]))
    .map((item, i) => [item.name, i] as const),
);
const byProject = projects.map((project) => ({
  id: project.id,
  name: project.name,
  tech: Object.entries(techProjects)
    .filter(([, ids]) => ids.includes(project.id))
    .map(([name]) => name)
    .sort((a, b) => (techOrder.get(a) ?? 0) - (techOrder.get(b) ?? 0)),
}));
---

<section class="tech" id="technologies" aria-labelledby="tech-heading">
  <h2 class="tech__heading" id="tech-heading">{copy.title}</h2>
  <p class="tech__lede">{copy.lede}</p>

  <input
    class="tech__view-input"
    type="radio"
    name="tech-view"
    id="tech-view-overall"
    checked
  />
  <input class="tech__view-input" type="radio" name="tech-view" id="tech-view-project" />
  <div class="tech__controls">
    <div class="tech__views">
      <label class="tech__view-label" for="tech-view-overall">{copy.viewOverall}</label>
      <label class="tech__view-label" for="tech-view-project">{copy.viewByProject}</label>
    </div>
  </div>

  <div class="tech__grid tech__grid--overall">
    {
      techStack.map((category) => (
        <div class="tech__category">
          <h3 class="tech__category-name">{copy.categories[category.id]}</h3>
          <ul class="tech__primaries">
            {category.primaries.map((primary) => (
              <li>
                {primary.secondaries && primary.secondaries.length > 0 ? (
                  <details class="tech__group">
                    <summary class="tech__primary">
                      <span class="tech__name">{primary.name}</span>
                      {wearsBadge(primary.context) && (
                        <span class="tech__badge">{copy.workBadge}</span>
                      )}
                      <span class="tech__marker" aria-hidden="true" />
                    </summary>
                    <ul class="tech__secondaries">
                      {primary.secondaries.map((secondary) => (
                        <li class="tech__secondary">
                          <span class="tech__name">{secondary.name}</span>
                          {wearsBadge(secondary.context) && (
                            <span class="tech__badge tech__badge--sm">
                              {copy.workBadge}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <p class="tech__primary tech__primary--leaf">
                    <span class="tech__name">{primary.name}</span>
                    {wearsBadge(primary.context) && (
                      <span class="tech__badge">{copy.workBadge}</span>
                    )}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="tech__grid tech__grid--project">
    {
      byProject.map((project) => (
        <div class="tech__category">
          <details class="tech__group">
            <summary class="tech__primary">
              <span class="tech__name">{project.name}</span>
              <span class="tech__count">{project.tech.length}</span>
              <span class="tech__marker" aria-hidden="true" />
            </summary>
            <ul class="tech__secondaries">
              {project.tech.map((name) => (
                <li class="tech__secondary">
                  <span class="tech__name">{name}</span>
                </li>
              ))}
            </ul>
          </details>
        </div>
      ))
    }
  </div>

  <p class="tech__legend">{copy.legend}</p>
</section>

<style>
  .tech {
    /* The gutter has to come from the width, not from a margin: `margin: auto`
       collapses to zero once the viewport is narrower than the max-width, and
       the box would sit flush against both screen edges. */
    width: min(60rem, 100% - 2rem);
    /* The summit panel above owns the top of the page and clears the fixed
       nav pill, so the box only needs a breath of sky before it. The
       `scroll-margin-top` keeps arrivals via the `#technologies` link clear
       of the nav. The bottom margin stays small on purpose: the climb's
       newest card sits directly below, and the box's lower edge has to peek
       into that view so a climber at the last card can see the page
       continues above. */
    margin: 2.5rem auto 0;
    scroll-margin-top: 6rem;
    padding: 2rem 1.75rem 2.25rem;
    border-radius: 12px;
    background: rgba(15, 12, 22, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.7);
  }

  .tech__heading {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    letter-spacing: 0.02em;
  }

  .tech__lede {
    margin: 0.5rem 0 1.75rem;
    max-width: 42ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(243, 238, 217, 0.62);
  }

  /* The two readings share one box rather than stacking. Two panels down the
     page would be two screens of scrolling and would ask the reader to hold
     the first in their head while looking at the second; sharing the space
     makes the comparison free. Driven by radio inputs and `:checked ~`, for
     the same reason `<details>` is used above: arrow-key navigation and
     labels come free, and it works with JavaScript off. `display: none` on
     the inactive panel takes it out of the accessibility tree, so a screen
     reader is never read both. */
  .tech__view-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tech__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .tech__views {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tech__view-label {
    padding: 0.42rem 0.95rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(243, 238, 217, 0.58);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .tech__view-label:hover {
    color: rgba(243, 238, 217, 0.85);
  }

  /* The selected label owns the light fill, so hover on the OTHER one must not
     read as a second selection. */
  .tech__view-input:checked + .tech__controls .tech__view-label:hover {
    background: transparent;
  }

  /* Reaches THROUGH `.tech__controls`. These rules used to target
     `~ .tech__views`, which worked while the toggle was a direct sibling of
     the inputs and silently stopped when it was wrapped: `~` matches siblings,
     and the wrapper became the sibling. The panel-swap rules below kept
     working because the grids are still siblings, so the control switched
     views while showing no selected state at all. */
  #tech-view-overall:checked ~ .tech__controls [for='tech-view-overall'],
  #tech-view-project:checked ~ .tech__controls [for='tech-view-project'] {
    background: rgba(243, 238, 217, 0.92);
    color: rgba(18, 14, 30, 0.95);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  /* The ring belongs on the label, since the input it belongs to is hidden. */
  #tech-view-overall:focus-visible ~ .tech__controls [for='tech-view-overall'],
  #tech-view-project:focus-visible ~ .tech__controls [for='tech-view-project'] {
    outline: 2px solid rgba(243, 238, 217, 0.75);
    outline-offset: 2px;
  }

  .tech__grid {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.75rem 2rem;
  }

  #tech-view-overall:checked ~ .tech__grid--overall,
  #tech-view-project:checked ~ .tech__grid--project {
    display: grid;
  }

  /* How many technologies the project uses — a size cue the category view
     does not need, because there the count is the visible row length. */
  .tech__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(243, 238, 217, 0.45);
  }

  .tech__category-name {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* 0.45 measured 4.03:1 on the composited card background — under AA at
       this size. These three tokens are the box's small text; they get the
       alpha that clears 4.5, not the one that looked right. */
    color: rgba(243, 238, 217, 0.58);
  }

  .tech__primaries,
  .tech__secondaries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech__primaries > li + li {
    margin-top: 0.35rem;
  }

  .tech__primary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    padding: 0.28rem 0.1rem;
    font-size: 0.95rem;
    color: rgba(243, 238, 217, 0.92);
  }

  /* A summary is focusable and clickable; a leaf primary is neither. */
  summary.tech__primary {
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
    transition: color 140ms ease;
  }

  summary.tech__primary::-webkit-details-marker {
    display: none;
  }

  summary.tech__primary:hover .tech__name,
  summary.tech__primary:focus-visible .tech__name {
    color: var(--color-accent, #f3eed9);
  }

  summary.tech__primary:focus-visible {
    outline: 2px solid rgba(243, 238, 217, 0.7);
    outline-offset: 3px;
  }

  .tech__marker {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: rgba(243, 238, 217, 0.62);
  }

  .tech__marker::before {
    content: '+';
  }

  [open] > .tech__primary .tech__marker::before {
    content: '\2212'; /* minus */
  }

  .tech__badge {
    flex: none;
    padding: 0.08rem 0.36rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: rgba(243, 238, 217, 0.6);
  }

  .tech__badge--sm {
    font-size: 0.55rem;
  }

  .tech__secondaries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.15rem 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    animation: tech-reveal 180ms ease-out;
  }

  /* Visibly lighter and smaller than a primary, so the level is never in doubt. */
  .tech__secondary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.16rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(243, 238, 217, 0.66);
  }

  .tech__legend {
    margin: 1.75rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
    color: rgba(243, 238, 217, 0.58);
  }

  @keyframes tech-reveal {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech__secondaries {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .tech {
      padding: 1.5rem 1.25rem 1.75rem;
    }

    .tech__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
