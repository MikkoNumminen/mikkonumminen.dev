---
/**
 * The technology box that closes `/experience`.
 *
 * Built on `<details>`/`<summary>` rather than a button and a script. That is
 * not minimalism for its own sake: the native element already answers every
 * requirement here — Enter and Space toggle it, the open state is exposed to
 * assistive technology without an `aria-expanded` I would have to keep in sync,
 * and a tap is just a click. Reaching for JavaScript would have meant
 * reimplementing all of it slightly worse.
 *
 * Primaries with nothing underneath render as a paragraph, not an inert
 * summary, so a keyboard user never tabs to something that does not respond.
 */
import { techStack, type TechContext } from '../../data/techStack';
import { techProjects } from '../../data/techProjects';
import { projects } from '../../data/projects';
import { asLocale, getTranslations, localizePath } from '../../i18n';
import { localizeTimeline } from '../../data/timeline';
import LinkifiedText from '../LinkifiedText.astro';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
const copy = t.techStack;

// This card IS the timeline's `now` entry. The entry stays in `timeline.ts`
// and TimelineContent skips it in the list, so its text lives in one place
// and `timeline.test.ts` keeps asserting it exists.
const now = localizeTimeline(t).find((entry) => entry.id === 'now');
/** `work` and `both` both mean it was used in client work; the badge says so. */
const wearsBadge = (context?: TechContext): boolean =>
  context === 'work' || context === 'both';

// The project view is a pivot of the same curated list, not a second list.
// Ordering follows `techStack`, so a technology sits in the same relative
// place whichever way the box is read.
const techOrder = new Map(
  techStack
    .flatMap((c) => c.primaries.flatMap((pr) => [pr, ...(pr.secondaries ?? [])]))
    .map((item, i) => [item.name, i] as const),
);
const byProject = projects.map((project) => ({
  id: project.id,
  name: project.name,
  tech: Object.entries(techProjects)
    .filter(([, ids]) => ids.includes(project.id))
    .map(([name]) => name)
    .sort((a, b) => (techOrder.get(a) ?? 0) - (techOrder.get(b) ?? 0)),
}));
---

<li
  class="timeline__entry timeline__entry--tech"
  data-timeline-entry
  data-altitude={now?.altitude}
  data-kind="now"
>
  <div class="timeline__marker" aria-hidden="true">
    <span class="timeline__dot">
      <span class="timeline__dot-ring"></span>
    </span>
    <span class="timeline__line"></span>
  </div>

  <section class="timeline__card tech" id="technologies" aria-labelledby="tech-heading">
    <span class="timeline__year-bg" aria-hidden="true">{now?.year}</span>
    <div class="timeline__meta">
      <span class="timeline__year">{now?.year}</span>
      <span class="timeline__kind">{t.experiencePage.kindNow}</span>
    </div>
    <h2 class="timeline__heading" id="tech-heading">{now?.title}</h2>
    <div class="timeline__body">
      <p>
        <LinkifiedText text={now?.body ?? ''} opensInNewTab={t.common.opensInNewTab} />
      </p>
    </div>
    {
      now?.tags && (
        <ul class="timeline__tags">
          {now.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    <input
      class="tech__view-input"
      type="radio"
      name="tech-view"
      id="tech-view-overall"
      checked
    />
    <input
      class="tech__view-input"
      type="radio"
      name="tech-view"
      id="tech-view-project"
    />
    <div class="tech__controls">
      <div class="tech__views">
        <label class="tech__view-label" for="tech-view-overall">{copy.viewOverall}</label>
        <label class="tech__view-label" for="tech-view-project"
          >{copy.viewByProject}</label
        >
      </div>
    </div>

    <div class="tech__grid tech__grid--overall">
      {
        techStack.map((category) => (
          <div class="tech__category">
            <h3 class="tech__category-name">{copy.categories[category.id]}</h3>
            <ul class="tech__primaries">
              {category.primaries.map((primary) => (
                <li>
                  {primary.secondaries && primary.secondaries.length > 0 ? (
                    <details class="tech__group">
                      <summary class="tech__primary">
                        <span class="tech__name">{primary.name}</span>
                        {wearsBadge(primary.context) && (
                          <span class="tech__badge">{copy.workBadge}</span>
                        )}
                        <span class="tech__marker" aria-hidden="true" />
                      </summary>
                      <ul class="tech__secondaries">
                        {primary.secondaries.map((secondary) => (
                          <li class="tech__secondary">
                            <span class="tech__name">{secondary.name}</span>
                            {wearsBadge(secondary.context) && (
                              <span class="tech__badge tech__badge--sm">
                                {copy.workBadge}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <p class="tech__primary tech__primary--leaf">
                      <span class="tech__name">{primary.name}</span>
                      {wearsBadge(primary.context) && (
                        <span class="tech__badge">{copy.workBadge}</span>
                      )}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="tech__grid tech__grid--project">
      {
        byProject.map((project) => (
          <div class="tech__category">
            <details class="tech__group">
              <summary class="tech__primary">
                <span class="tech__name">{project.name}</span>
                <span class="tech__count">{project.tech.length}</span>
                <span class="tech__marker" aria-hidden="true" />
              </summary>
              <ul class="tech__secondaries">
                {project.tech.map((name) => (
                  <li class="tech__secondary">
                    <span class="tech__name">{name}</span>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        ))
      }
    </div>

    <p class="tech__legend">{copy.legend}</p>

    <div class="tech__routes">
      <a class="tech__route" href={localizePath('/blog', locale)}>
        {t.experiencePage.summitBlogLink}
        <span aria-hidden="true">&#8594;</span>
      </a>
      <a class="tech__route" href={localizePath('/contact', locale)}>
        {t.experiencePage.summitContactLink}
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </section>
</li>

<style>
  /* Chrome, width and padding all come from `.timeline__card`. Nothing is
     duplicated here, so the box cannot drift away from the cards it sits
     among — it was 960px against their 656px precisely because it owned its
     own width. Only the scroll anchor and the reveal-safe defaults remain. */
  .tech {
    scroll-margin-top: 6rem;
  }

  /* It is a real `[data-timeline-entry]` now, so it reveals, anchors the goat
     and highlights when centred exactly like every other card. The list's own
     `gap` supplies the spacing that a hard-coded 25vh margin used to. */
  .timeline__entry--tech {
    scroll-margin-top: 6rem;
  }

  .tech__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .tech__route {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.08);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.95);
    text-decoration: none;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .tech__route:hover,
  .tech__route:focus-visible {
    background: rgba(var(--accent-rgb), 0.16);
    border-color: rgba(var(--accent-rgb), 0.7);
  }

  .tech__heading {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    letter-spacing: 0.02em;
  }

  /* The two readings share one box rather than stacking. Two panels down the
     page would be two screens of scrolling and would ask the reader to hold
     the first in their head while looking at the second; sharing the space
     makes the comparison free. Driven by radio inputs and `:checked ~`, for
     the same reason `<details>` is used above: arrow-key navigation and
     labels come free, and it works with JavaScript off. `display: none` on
     the inactive panel takes it out of the accessibility tree, so a screen
     reader is never read both. */
  .tech__view-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Separates the card's identity block (meta, title, availability, tags)
     from the stack controls below it. Without this the toggle reads as a
     third row of tags. */
  .tech__controls {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .tech__views {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tech__view-label {
    padding: 0.42rem 0.95rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(243, 238, 217, 0.58);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .tech__view-label:hover {
    color: rgba(243, 238, 217, 0.85);
  }

  /* Reaches THROUGH `.tech__controls`. These rules used to target
     `~ .tech__views`, which worked while the toggle was a direct sibling of
     the inputs and silently stopped when it was wrapped: `~` matches siblings,
     and the wrapper became the sibling. The panel-swap rules below kept
     working because the grids are still siblings, so the control switched
     views while showing no selected state at all. */
  #tech-view-overall:checked ~ .tech__controls [for='tech-view-overall'],
  #tech-view-project:checked ~ .tech__controls [for='tech-view-project'] {
    background: rgba(243, 238, 217, 0.92);
    color: rgba(18, 14, 30, 0.95);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  /* The ring belongs on the label, since the input it belongs to is hidden. */
  #tech-view-overall:focus-visible ~ .tech__controls [for='tech-view-overall'],
  #tech-view-project:focus-visible ~ .tech__controls [for='tech-view-project'] {
    outline: 2px solid rgba(243, 238, 217, 0.75);
    outline-offset: 2px;
  }

  /* Multi-column flow rather than a fixed grid. Five blocks in a 3-column
     grid left the third cell of row 2 entirely empty (279x399px) and row
     stretch added 339px of internal slack on top. Columns let the blocks
     balance themselves, so adding a technology can never reopen a hole. */
  .tech__grid {
    display: none;
    columns: 2;
    column-gap: 2rem;
    column-fill: balance;
  }

  #tech-view-overall:checked ~ .tech__grid--overall,
  #tech-view-project:checked ~ .tech__grid--project {
    display: block;
  }

  /* How many technologies the project uses — a size cue the category view
     does not need, because there the count is the visible row length. */
  .tech__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(243, 238, 217, 0.45);
  }

  .tech__category {
    break-inside: avoid;
    margin-bottom: 1.05rem;
  }

  .tech__category:last-child {
    margin-bottom: 0;
  }

  .tech__category-name {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* 0.45 measured 4.03:1 on the composited card background — under AA at
       this size. These three tokens are the box's small text; they get the
       alpha that clears 4.5, not the one that looked right. */
    color: rgba(243, 238, 217, 0.58);
  }

  .tech__primaries,
  .tech__secondaries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech__primaries > li + li {
    margin-top: 0.1rem;
  }

  .tech__primary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    padding: 0.14rem 0.1rem;
    font-size: 0.92rem;
    color: rgba(243, 238, 217, 0.92);
  }

  /* A summary is focusable and clickable; a leaf primary is neither. */
  summary.tech__primary {
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
    transition: color 140ms ease;
  }

  summary.tech__primary::-webkit-details-marker {
    display: none;
  }

  summary.tech__primary:hover .tech__name,
  summary.tech__primary:focus-visible .tech__name {
    color: var(--color-accent, #f3eed9);
  }

  summary.tech__primary:focus-visible {
    outline: 2px solid rgba(243, 238, 217, 0.7);
    outline-offset: 3px;
  }

  .tech__marker {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: rgba(243, 238, 217, 0.62);
  }

  .tech__marker::before {
    content: '+';
  }

  [open] > .tech__primary .tech__marker::before {
    content: '\2212'; /* minus */
  }

  .tech__badge {
    flex: none;
    padding: 0.08rem 0.36rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: rgba(243, 238, 217, 0.6);
  }

  .tech__badge--sm {
    font-size: 0.55rem;
  }

  .tech__secondaries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.15rem 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    animation: tech-reveal 180ms ease-out;
  }

  /* Visibly lighter and smaller than a primary, so the level is never in doubt. */
  .tech__secondary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.16rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(243, 238, 217, 0.66);
  }

  .tech__legend {
    margin: 1.25rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
    color: rgba(243, 238, 217, 0.58);
  }

  @keyframes tech-reveal {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech__secondaries {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    /* One column, and the card's 1.75rem side padding is given back: the
       entry grid spends 56px on the marker at this width, so the content
       column is already narrow and the chip rows need every pixel. */
    .tech__grid {
      columns: 1;
    }

    .tech {
      padding-left: 1.1rem;
      padding-right: 1.1rem;
    }
  }
</style>
