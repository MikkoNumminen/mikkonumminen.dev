<div class="goat-wrap" data-goat aria-hidden="true">
  <div class="goat">
    <svg
      viewBox="0 0 80 60"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Body -->
      <ellipse cx="40" cy="34" rx="22" ry="11" fill="#f5efe2"></ellipse>
      <!-- Belly shading -->
      <ellipse cx="40" cy="38" rx="20" ry="6" fill="#e6dccb" opacity="0.6"></ellipse>
      <!-- Head -->
      <ellipse cx="62" cy="22" rx="10" ry="8" fill="#f5efe2"></ellipse>
      <!-- Snout -->
      <ellipse cx="70" cy="24" rx="4" ry="3" fill="#e6dccb"></ellipse>
      <!-- Eye -->
      <circle cx="64" cy="20" r="1.2" fill="#0f1114"></circle>
      <!-- Horns -->
      <path
        d="M58 16 Q56 8 60 6"
        stroke="#3d2f1f"
        stroke-width="2"
        stroke-linecap="round"
        fill="none"></path>
      <path
        d="M62 15 Q63 7 67 6"
        stroke="#3d2f1f"
        stroke-width="2"
        stroke-linecap="round"
        fill="none"></path>
      <!-- Ear -->
      <ellipse
        cx="55"
        cy="17"
        rx="2.5"
        ry="1.5"
        fill="#d8cdb6"
        transform="rotate(-25 55 17)"></ellipse>
      <!-- Beard -->
      <path
        d="M68 27 Q67 31 65 33"
        stroke="#f5efe2"
        stroke-width="2"
        stroke-linecap="round"
        fill="none"></path>
      <!-- Legs (front + back) — animated by CSS -->
      <g class="goat__legs">
        <rect
          class="goat__leg goat__leg--fl"
          x="50"
          y="40"
          width="3"
          height="14"
          rx="1"
          fill="#3d2f1f"></rect>
        <rect
          class="goat__leg goat__leg--fr"
          x="56"
          y="40"
          width="3"
          height="14"
          rx="1"
          fill="#3d2f1f"></rect>
        <rect
          class="goat__leg goat__leg--bl"
          x="24"
          y="40"
          width="3"
          height="14"
          rx="1"
          fill="#3d2f1f"></rect>
        <rect
          class="goat__leg goat__leg--br"
          x="30"
          y="40"
          width="3"
          height="14"
          rx="1"
          fill="#3d2f1f"></rect>
      </g>
      <!-- Tail -->
      <path
        d="M18 33 Q12 32 14 28"
        stroke="#f5efe2"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"></path>
    </svg>
  </div>
</div>

<style>
  .goat-wrap {
    /* JS sets --goat-x / --goat-y to the viewport-coord position where the
       goat's CENTER should sit. The trailing translate(-50%, -50%) recentres
       the rendered SVG on that point regardless of its intrinsic size.
       Smoothing happens in JS (gsap.ticker lerp) — no CSS transition here,
       which would compound and feel rubbery. */
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    pointer-events: none;
    transform: translate(var(--goat-x, 50vw), var(--goat-y, 50vh)) translate(-50%, -50%);
    will-change: transform;
    /* Opacity, unlike position, IS transitioned. The lerp smooths movement;
       leaving the climb is a state change and wants a fade, not a slide. */
    transition: opacity 320ms ease;
  }

  /* Set once the climb is entirely out of view — the reader has gone above it
     into the Technologies box and the summit panel. The goat belongs to the
     mountain: with no card left to stand on it was clamping to the viewport
     edge and pasting itself over the stack list. */
  .goat-wrap[data-offpiste='true'] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .goat-wrap {
      transition: none;
    }
  }

  .goat {
    position: relative;
    width: clamp(56px, 7vw, 90px);
    animation: goat-bob 1s ease-in-out infinite;
    /* The wrap is pointer-events: none so the goat never blocks the
       page; re-enabled here for the click-to-bleat easter egg (migrated
       from the old home-hero goat). Cursor stays default on purpose —
       hidden easter eggs don't advertise. */
    pointer-events: auto;
  }

  .goat svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.45));
  }

  @keyframes goat-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-3px) rotate(1deg);
    }
  }

  /* Walking — alternating leg lifts */
  .goat__leg {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: leg-walk 0.6s ease-in-out infinite;
  }
  .goat__leg--fl,
  .goat__leg--br {
    animation-delay: 0s;
  }
  .goat__leg--fr,
  .goat__leg--bl {
    animation-delay: 0.3s;
  }

  @keyframes leg-walk {
    0%,
    100% {
      transform: rotate(0);
    }
    50% {
      transform: rotate(-15deg);
    }
  }

  /* Click-to-bleat: a hop with a scale pulse plus a dust puff at the
     hooves. The hop runs on the inner svg so it composes with the idle
     bob on .goat instead of replacing it mid-cycle. */
  .goat--bleat svg {
    animation: goat-bleat 0.6s ease-out;
  }

  @keyframes goat-bleat {
    0% {
      transform: translateY(0) scale(1);
    }
    35% {
      transform: translateY(-14px) scale(1.16);
    }
    100% {
      transform: translateY(0) scale(1);
    }
  }

  .goat::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 26px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(245, 239, 226, 0.5),
      rgba(245, 239, 226, 0)
    );
    transform: translateX(-50%) scale(0);
    pointer-events: none;
  }

  .goat--bleat::after {
    animation: goat-dust 0.6s ease-out;
  }

  @keyframes goat-dust {
    0% {
      transform: translateX(-50%) scale(0.2);
      opacity: 0;
    }
    30% {
      opacity: 0.8;
    }
    100% {
      transform: translateX(-50%) scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .goat-wrap {
      will-change: auto;
    }
    .goat,
    .goat__leg,
    .goat--bleat svg,
    .goat::after {
      animation: none;
    }
  }
</style>

<script>
  import { onRoute } from '../../lib/lifecycle';

  // Click-to-bleat easter egg, migrated from the old home-hero goat when
  // the hero's zone decor was retired for the particle field. Purely
  // decorative: the goat is aria-hidden and gets no cursor affordance.
  // Reduced-motion clients skip the listener entirely — the goat stays a
  // static illustration for them.
  onRoute(
    () => !!document.querySelector('[data-goat]'),
    () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const goat = document.querySelector<HTMLElement>('[data-goat] .goat');
      if (!goat) return;

      const onPointerDown = (): void => {
        // One bleat at a time — restarting mid-hop reads as a glitch,
        // not an eager goat.
        if (goat.classList.contains('goat--bleat')) return;
        goat.classList.add('goat--bleat');
        window.setTimeout(() => goat.classList.remove('goat--bleat'), 650);
      };
      goat.addEventListener('pointerdown', onPointerDown);

      return () => {
        goat.removeEventListener('pointerdown', onPointerDown);
        goat.classList.remove('goat--bleat');
      };
    },
  );
</script>
