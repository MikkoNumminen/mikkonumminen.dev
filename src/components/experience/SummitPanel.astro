---
/**
 * The topmost block of /experience: where the climb ends and the site goes on.
 *
 * One panel instead of exit buttons scattered along the top. The summit line
 * and the two routes onward (blog, contact) live together here, directly above
 * the Technologies box, so a reader who reaches the top gets a single place to
 * pick a next destination.
 *
 * Rendered as a dark card rather than open text: the viewport-fixed sun sits
 * high at full daylight, which is exactly the sky behind this block, and a
 * text-shadow alone has not been enough to hold small type against its core.
 * The backing matches the card language of the Technologies box below.
 */
import { asLocale, getTranslations, localizePath } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<div class="summit-panel-zone">
  <section class="summit-panel" aria-labelledby="summit-line">
    <p class="summit-panel__line" id="summit-line">{t.experiencePage.summit}</p>
    <p class="summit-panel__note">{t.experiencePage.summitNote}</p>
    <div class="summit-panel__routes">
      <a class="summit-panel__route" href={localizePath('/blog', locale)}>
        {t.experiencePage.summitBlogLink}
        <span aria-hidden="true">&#8594;</span>
      </a>
      <a class="summit-panel__route" href={localizePath('/contact', locale)}>
        {t.experiencePage.summitContactLink}
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </section>
</div>

<style>
  .summit-panel-zone {
    display: flex;
    justify-content: center;
    /* Clears the fixed nav pill, which overlays the top of the document.
       Padding rather than a margin on the card, so the spacing cannot
       collapse out of the track. */
    padding: 7rem 1rem 0;
  }

  .summit-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: min(34rem, 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    border-radius: 12px;
    /* Matches the Technologies box below, and measured deliberately darker
       than the 0.55 control backing: the sun's core sits directly behind this
       card at scroll 0 and bled through the lighter alpha on small screens. */
    background: rgba(15, 12, 22, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .summit-panel__line {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(243, 238, 217, 0.88);
  }

  .summit-panel__note {
    margin: 0;
    max-width: 34ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(243, 238, 217, 0.78);
  }

  .summit-panel__routes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  /* PARALLEL TO `.timeline__skip` at base camp — the same kind of control at
     the opposite end of the climb, kept visually matched. */
  .summit-panel__route {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(18, 14, 30, 0.55);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 238, 217, 0.92);
    text-decoration: none;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .summit-panel__route:hover,
  .summit-panel__route:focus-visible {
    background: rgba(32, 26, 52, 0.78);
    border-color: rgba(255, 255, 255, 0.55);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .summit-panel__route:hover,
    .summit-panel__route:focus-visible {
      transform: none;
    }
  }
</style>
