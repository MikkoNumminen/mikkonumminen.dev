---
/**
 * The five-stroke pinwheel from the Asuntokanava logo, as inline SVG so each
 * stroke can be animated on its own (`--i` is the stroke's index). Decorative:
 * always aria-hidden, colour comes from `fill` in the caller's CSS.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const strokes = [
  'M97.1232 96.1027H64.811L68.636 108H56.2672L51.1241 91.993C50.5403 90.183 50.8533 88.1996 51.9608 86.6603C53.0682 85.1211 54.8378 84.2085 56.7187 84.2085H100.951L97.1292 96.0997L97.1232 96.1027Z',
  'M86.1357 14.5012L80.9143 30.7515C80.3335 32.5615 78.9281 33.9821 77.1375 34.5692C76.5416 34.7639 75.9307 34.8613 75.3198 34.8613C74.095 34.8613 72.8792 34.4719 71.862 33.7236L35.9475 7.34946L45.9538 0L72.2261 19.2923L76.1293 7.15173L86.1357 14.5012Z',
  'M42.0356 29.55C42.0356 31.4543 41.1328 33.243 39.61 34.3624L3.82197 60.6392L0 48.748L26.1459 29.55L15.9319 22.0484L25.9382 14.699L39.61 24.7406C41.1328 25.857 42.0356 27.6488 42.0356 29.55Z',
  'M43.8894 107.997H31.5207L21.5655 77.0263L11.4719 84.4366L7.6499 72.5454L21.2044 62.5981C22.7271 61.4787 24.6893 61.1653 26.4799 61.7555C28.2705 62.3426 29.6759 63.7632 30.2567 65.5702L43.8924 107.997H43.8894Z',
  'M108.589 60.4353L104.764 72.3265H88.0226C86.1417 72.3265 84.3692 71.4139 83.2617 69.8746C82.1573 68.3354 81.8443 66.352 82.4251 64.542L96.1451 21.8567L106.154 29.2062L96.118 60.4353H108.586H108.589Z',
];
---

<svg
  class={className}
  viewBox="0 0 109 108"
  aria-hidden="true"
  focusable="false"
  data-brand-mark
>
  {strokes.map((d, i) => (
    <path style={`--i:${i}`} d={d} />
  ))}
</svg>
