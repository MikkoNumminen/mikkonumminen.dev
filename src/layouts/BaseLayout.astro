---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteNav from '../components/nav/SiteNav.astro';
import BackgroundAudio from '../components/BackgroundAudio.astro';
import {
  asLocale,
  getTranslations,
  localizePath,
  stripLocale,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from '../i18n';
import { cvPaper, paperUrl } from '../data/papers';
import { publicFileSize } from '../lib/publicFileSize';
import type { Theme } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  theme?: Theme;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** ISO 8601 timestamp. Only meaningful alongside `ogType="article"`. */
  publishedTime?: string;
  /**
   * Locales this page actually exists in. Routes built from static data exist
   * in every locale by construction, so the default is correct for them. Routes
   * built from content do not: an entry published in one locale only would
   * otherwise advertise a switcher link and an hreflang alternate to a URL
   * the build never generated.
   */
  availableLocales?: readonly Locale[];
}

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

const cvFile = cvPaper();
const cvFileSize = publicFileSize(cvFile.filename);

const {
  title,
  description = t.meta.home.description,
  theme = 'home',
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  availableLocales = LOCALES,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Build hreflang alternates by stripping the current locale from the path
// and re-localizing for each locale this page exists in.
const basePath = stripLocale(Astro.url.pathname);
const alternates = availableLocales.map((l) => ({
  locale: l,
  href: new URL(localizePath(basePath, l), Astro.site).toString(),
}));
// x-default is the fallback for languages we don't publish, which is English
// wherever it exists. When it doesn't, the current locale is the only page we
// can name that the build actually produced.
const xDefaultLocale = availableLocales.includes(DEFAULT_LOCALE)
  ? DEFAULT_LOCALE
  : locale;
const xDefault = new URL(localizePath(basePath, xDefaultLocale), Astro.site).toString();
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050807" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="mikkonumminen.dev" />
    <meta property="og:locale" content={locale === 'fi' ? 'fi_FI' : 'en_US'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!--
      Browser language detection. Runs once per session before paint.
      - If the user already manually picked a language, never auto-redirect.
      - Otherwise read navigator.languages and redirect to the matching
        locale subtree (fi → /fi/..., anything else → /...).

      TESTING: this moves you off a locale route your browser did not ask
      for, and it does so in the page. The server response for /fi/... is a
      plain 200 with no redirect header and the file really is in dist, so
      curl, the build output and every server-side check all look correct
      while an automated browser silently ends up on the English page. A
      Playwright run that opens /fi/... in a default context measures the
      English page and reports success. Set the context locale instead:
      browser.newContext({ locale: 'fi-FI' }).
    -->
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('mn_lang_checked')) return;
          sessionStorage.setItem('mn_lang_checked', '1');
          if (localStorage.getItem('mn_preferred_locale')) return;

          const path = location.pathname;
          let current = 'en';
          if (path === '/fi' || path.indexOf('/fi/') === 0) current = 'fi';

          const langs = navigator.languages || [navigator.language || 'en'];
          let target = null;
          for (let i = 0; i < langs.length; i++) {
            const l = (langs[i] || '').toLowerCase().slice(0, 2);
            if (l === 'fi' || l === 'en') {
              target = l;
              break;
            }
          }
          if (!target) target = 'en';
          if (target === current) return;

          // Strip current locale prefix to get the bare path.
          let bare = path.replace(/^\/fi(\/|$)/, '/');
          if (bare === '') bare = '/';

          let next;
          if (target === 'en') {
            next = bare;
          } else if (bare === '/') {
            next = '/' + target;
          } else {
            next = '/' + target + bare;
          }
          if (next !== path) location.replace(next + location.search + location.hash);
        } catch {
          /* ignore */
        }
      })();
    </script>

    <slot name="head" />

    <ClientRouter />
  </head>
  <body data-theme={theme}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-white focus:text-black focus:px-3 focus:py-2 focus:rounded"
    >
      {t.nav.skipToContent}
    </a>

    <SiteNav
      theme={theme}
      current={Astro.url.pathname}
      locale={locale}
      availableLocales={availableLocales}
    />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {
      /* Before the footer in reading order, not after it. The control is
        position:fixed so nothing moves visually, but it is the last
        focusable element on the page and the last thing a linear read
        reaches — and it now yields to the footer, so it has to come
        first or a reader arrives at an empty corner. */
    }
    <BackgroundAudio />

    {
      /* The CV reaches every route from here. The hero pill only exists on
        the landing page, and the fixed nav is already six links plus the
        language switcher and scrolls horizontally under 600px, so the
        footer is the one place a persistent link costs nothing. */
    }
    <footer class="site-footer" data-site-footer>
      <span>{t.navCards.footerCopyright}</span>
      <a
        class="site-footer__cv"
        href={paperUrl(cvFile)}
        download={cvFile.filename}
        data-astro-prefetch="false"
        aria-label={t.common.downloadCvAria.replace('{size}', cvFileSize)}
      >
        {t.navCards.footerCv}
      </a>
      <span>{t.navCards.footerBuiltWith}</span>
    </footer>

    <style is:global>
      .site-footer {
        position: relative;
        z-index: 20;
        max-width: 1100px;
        margin: 6rem auto 0;
        padding: 2rem 1.5rem 2.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        /* Grid rather than `justify-content: space-between`. With two items
           space-between centred nothing and did not need to; with three it
           equalises the GAPS, so the middle item lands off-centre by half the
           difference between the outer two, which here is the copyright
           against a longer build credit. Equal outer tracks centre the middle
           item regardless of what the outer two say. */
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
      }

      .site-footer > :last-child {
        text-align: right;
      }

      /* Brighter than the two spans beside it: those are notices, this is
         the one thing in the footer a visitor might want to click.

         The padding is not decoration. Text alone gave the anchor a 17px-tall
         hit box, under the 24px floor in WCAG 2.2 SC 2.5.8, and the inline
         exception does not apply because this is a standalone control in a
         row rather than a link inside running prose. The negative inline
         margin keeps the added padding from widening the middle grid track
         and shifting the label off the centre line. */
      .site-footer__cv {
        color: rgba(196, 212, 255, 0.85);
        text-decoration: none;
        transition: color 0.3s ease;
        display: inline-block;
        padding: 0.75rem 0.5rem;
        margin: -0.75rem -0.5rem;
      }

      .site-footer__cv:hover,
      .site-footer__cv:focus-visible {
        color: #fff;
      }

      /* Stacked, because three mono uppercase strings do not fit one row on a
         phone. `grid-template-columns: 1fr` rather than the `flex-direction:
         column` this used to say: the container is a grid now, and
         `flex-direction` on a grid container is inert, so the three items
         stayed side by side and the outer two wrapped to a smear. The
         `:last-child` reset is needed for the same reason the rule above
         exists — it out-specifies the `text-align: center` here. */
      @media (max-width: 860px) {
        .site-footer {
          grid-template-columns: 1fr;
          justify-items: center;
          gap: 0.75rem;
          text-align: center;
        }

        .site-footer > :last-child {
          text-align: center;
        }
      }
    </style>

    <script>
      // Bottom-corner chrome is position:fixed and does not scroll away;
      // the footer arrives underneath it at the end of every page. Rather
      // than hiding the chrome — which would take the only audio control
      // on the site with it, destroy focus if a keyboard user is inside
      // it, and latch permanently on a page too short to scroll — publish
      // how far the footer has intruded and let the chrome ride up on top
      // of it. Nothing is ever taken away; the footer slides underneath.
      //
      // Owned by the layout, not a component: the collision is site-wide,
      // and the component that used to own it only exists on the home
      // page, so every other page had chrome sitting on its footer.
      import { trackFooterOverlap } from '../lib/utils/trackFooterOverlap';
      import { onRoute } from '../lib/lifecycle';

      onRoute(
        () => !!document.querySelector('[data-site-footer]'),
        () => {
          const footer = document.querySelector<HTMLElement>('[data-site-footer]');
          if (!footer) return;
          const handle = trackFooterOverlap({ target: footer });
          return () => handle.dispose();
        },
      );
    </script>

    <script>
      import { initObservability } from '../lib/observability/initObservability';

      // Once-only: Sentry.init must not repeat, so this runs on module load
      // (once per session) rather than on every astro:page-load. Guarded on a
      // missing DSN, so it's a no-op when observability isn't configured.
      initObservability();
    </script>
  </body>
</html>
