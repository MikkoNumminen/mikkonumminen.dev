---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AiBadge from '../components/blog/AiBadge.astro';
import { asLocale, getTranslations, localizePath } from '../i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, aiGenerated, tags } = entry.data;

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

const { Content } = await render(entry);

// Frontmatter dates are date-only, so they parse as UTC midnight. Formatting
// them in the build host's zone renders the previous day west of UTC.
const dateLabel = date.toLocaleDateString(entry.data.locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description} theme="home">
  <article class="blog-post">
    <header class="blog-post__header">
      <p class="blog-post__meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
      </p>

      <h1 class="blog-post__title">{title}</h1>

      {
        aiGenerated && (
          <div class="blog-post__disclosure">
            <AiBadge size="lg" />
            <p class="blog-post__notice">{t.blog.aiNotice}</p>
          </div>
        )
      }

      {
        tags.length > 0 && (
          <ul class="blog-post__tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="blog-post__body">
      <Content />
    </div>

    <a class="blog-post__back" href={localizePath('/blog', locale)}>
      {t.blog.backToIndex}
    </a>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 820px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  .blog-post__header {
    margin-bottom: 3rem;
  }

  .blog-post__meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1.25rem;
  }

  .blog-post__title {
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 2rem;
    color: #fff;
    max-width: 22ch;
  }

  .blog-post__disclosure {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-left-width: 4px;
    border-radius: 8px;
    background: rgba(251, 191, 36, 0.08);
  }

  .blog-post__notice {
    margin: 0;
    max-width: 62ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .blog-post__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .blog-post__tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
  }

  /* Astro's scoping never reaches markdown rendered through <Content />, so
     every prose rule has to be written through :global from this wrapper. */
  .blog-post__body {
    max-width: 70ch;
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.78);
  }

  .blog-post__body :global(p) {
    margin: 0 0 1.4rem;
  }

  .blog-post__body :global(h2) {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #fff;
    margin: 3rem 0 1rem;
  }

  .blog-post__body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.92);
    margin: 2.25rem 0 0.75rem;
  }

  .blog-post__body :global(ul),
  .blog-post__body :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.35rem;
  }

  .blog-post__body :global(li) {
    margin: 0 0 0.5rem;
  }

  .blog-post__body :global(a) {
    color: var(--color-home-accent);
    text-decoration: underline;
    text-decoration-color: rgba(196, 212, 255, 0.4);
    text-underline-offset: 3px;
  }

  .blog-post__body :global(a:hover) {
    text-decoration-color: var(--color-home-accent);
  }

  .blog-post__body :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .blog-post__body :global(blockquote) {
    margin: 0 0 1.4rem;
    padding-left: 1.1rem;
    border-left: 2px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.65);
  }

  .blog-post__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 0.15em 0.4em;
  }

  .blog-post__body :global(pre) {
    margin: 0 0 1.6rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .blog-post__body :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .blog-post__body :global(hr) {
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 2.5rem 0;
  }

  .blog-post__back {
    display: inline-block;
    margin-top: 3.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
  }

  .blog-post__back:hover,
  .blog-post__back:focus-visible {
    color: #fff;
  }
</style>
