---
/**
 * The research listing.
 *
 * WHY IT EXISTS. Eleven papers were reachable only by typing `download` into the
 * terminal on the contact page, and nothing told a visitor that command was
 * there. `commands.ts` carries the receipt: a visitor who wanted the research
 * "saw neither the research nor an error, and went and asked the chat instead."
 *
 * A LISTING, NOT A READER. Every row links its PDF. Reading a paper in the
 * browser is deliberately later work, because it is gated on translating each
 * document into Finnish (`slugParity.test.ts` fails the build on a published
 * slug with no Finnish counterpart), while the one-line summaries below were
 * already translated for the terminal and cost nothing to reuse.
 *
 * The page owns no list of its own. `src/data/papers.ts` is the single source,
 * shared with the terminal command, and `papers.test.ts` keeps it honest.
 */
import { statSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { asLocale, getTranslations } from '../i18n';
import { localizePapers, type LocalizedPaper } from '../data/papers';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

/**
 * Newest first, which is the opposite of the terminal.
 *
 * The data is stored oldest-first because the terminal renders it as a trail and
 * says so ("oldest to newest"). A listing of current work reads the other way,
 * so the reversal happens here rather than in the data, and neither surface has
 * to apologise for the other's order.
 */
const papers: LocalizedPaper[] = localizePapers(t)
  .filter((paper) => paper.tier === 'research')
  .reverse();

/**
 * Size, read at build time.
 *
 * Resolved from `process.cwd()` and NOT from `import.meta.url`, which was the
 * first attempt and broke the build: this frontmatter is bundled into
 * `dist/.prerender/chunks/`, so a URL relative to the module resolved to
 * `dist/public/…` and every stat threw ENOENT. `astro build` and `astro dev`
 * both run from the project root, which the chunk's own location does not track.
 *
 * A missing file fails the build rather than degrading, because a listing that
 * silently drops a paper is the failure this whole page exists to fix.
 */
const sizeOf = (filename: string): string => {
  const bytes = statSync(path.join(process.cwd(), 'public', filename)).size;
  return `${Math.round(bytes / 1024)} KB`;
};

const dateFormat = new Intl.DateTimeFormat(locale === 'fi' ? 'fi-FI' : 'en-GB', {
  year: 'numeric',
  month: 'long',
});
/** `'2026-07'` rendered for humans. Day-of-month is not part of the data. */
const readableDate = (date: string): string =>
  dateFormat.format(new Date(`${date}-01T00:00:00Z`));
---

<BaseLayout
  title={t.meta.research.title}
  description={t.meta.research.description}
  theme="home"
>
  <section class="research" aria-label={t.researchPage.title}>
    <header class="research__header">
      <p class="research__eyebrow">{t.researchPage.eyebrow}</p>
      <h1 class="research__title">{t.researchPage.title}</h1>
      <p class="research__lede">{t.researchPage.lede}</p>
    </header>

    <ol class="research__list">
      {
        papers.map((paper) => (
          <li class="research__item">
            <time class="research__date" datetime={paper.date}>
              {readableDate(paper.date)}
            </time>
            <h2 class="research__name">{paper.title}</h2>
            <p class="research__summary">{paper.summary}</p>
            <a
              class="research__download"
              href={paper.url}
              download={paper.filename}
              aria-label={t.researchPage.downloadAria.replace('{title}', paper.title)}
            >
              {t.researchPage.pdfLabel} · {sizeOf(paper.filename)}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .research {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1.25rem 5rem;
  }

  .research__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .research__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
  }

  .research__lede {
    margin: 0 0 3rem;
    max-width: 62ch;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .research__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.25rem;
  }

  .research__item {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
  }

  .research__item:last-child {
    border-bottom: none;
  }

  .research__date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .research__name {
    margin: 0;
    font-size: clamp(1.1rem, 2.6vw, 1.4rem);
    line-height: 1.35;
  }

  .research__summary {
    margin: 0;
    max-width: 68ch;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .research__download {
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.18));
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--color-text);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .research__download:hover,
  .research__download:focus-visible {
    border-color: var(--color-accent, rgba(255, 255, 255, 0.5));
    background: rgba(255, 255, 255, 0.06);
  }
</style>
