---
import { execSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Intro from '../components/home/Intro.astro';
import LatestEntries from '../components/home/LatestEntries.astro';
import NavCards from '../components/home/NavCards.astro';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Recent commit subjects, baked in at build time. Drives the impact-text
// popups that burst from each meteor strike on the home hero galaxy.
// We strip each subject to its conventional-commit type+scope and only
// keep the ones with an explicit (scope). NO dedup — the popup pool is
// the latest ~40 prefixes in chronological order, repetitions and all,
// so the rhythm reflects what was *actually* committed lately rather
// than a historical hall-of-fame of every scope ever used. Falls back
// to an empty array outside a git checkout; the scene then uses its
// own hardcoded sentinel list.
let commitMessages: string[] = [];
try {
  const subjects = execSync('git log --pretty=format:%s -n 60', {
    encoding: 'utf8',
  })
    .split('\n')
    .map((s) => s.trim())
    .filter((s) => s.length > 0)
    .filter((s) => !/^Merge /i.test(s))
    .map((s) => s.split(':')[0]!.trim())
    .filter((p) => /\([^()]+\)$/.test(p));
  commitMessages = subjects.slice(0, 40);
} catch {
  // Outside a git checkout (e.g. a history-less clone) — leave the empty
  // initializer; the scene falls back to its hardcoded sentinel list.
}

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mikko Numminen',
  jobTitle: t.meta.jobTitle,
  // Read from Astro.site so the JSON-LD url stays in lockstep with the
  // canonical link — otherwise structured data drifts whenever the site
  // host changes (see the comment in astro.config.mjs).
  url: Astro.site?.href ?? 'https://mikkonumminen.dev',
  email: 'numminen.mikko.petteri@gmail.com',
  nationality: 'Finnish',
  sameAs: [
    'https://github.com/MikkoNumminen',
    'https://www.linkedin.com/in/mikko-numminen-269795205/',
  ],
  knowsAbout: [
    'TypeScript',
    'Python',
    'Next.js',
    'React',
    'Node.js',
    'PostgreSQL',
    'MongoDB',
    'Prisma',
    'Material-UI',
    'Tailwind CSS',
    'Astro',
    'Three.js',
    'Jest',
    'Playwright',
    'Docker',
    'Turborepo',
    'Open data',
    'UI design',
    'Usability',
  ],
};
---

<BaseLayout title={t.meta.home.title} description={t.meta.home.description} theme="home">
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </Fragment>

  {/* The unified particle field. Fixed and full-viewport so the field
      persists behind every section of the page — the hero no longer owns
      it. z-index -1 paints it above the body background but below all
      normal-flow content. pointer-events: none: clicks are observed at
      the document level by the scene, never captured by the canvas. */}
  <canvas
    id="home-canvas"
    class="field-canvas"
    aria-hidden="true"
    data-commit-messages={JSON.stringify(commitMessages)}></canvas>

  <Hero />
  <Intro />
  <LatestEntries />
  <NavCards />
</BaseLayout>

<style>
  .field-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: block;
  }

  /* Small screens and reduced-motion clients never get the WebGL field —
     the boot script skips scene creation and the DOM fallback title in
     the hero takes over. Hiding the canvas here keeps those paths free
     of a stray transparent element and mirrors the old hero CSS. */
  @media (max-width: 640px) {
    .field-canvas {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-canvas {
      display: none;
    }
  }
</style>

<style is:global>
  /* Commit-message popups (src/lib/home/commitPopups.ts). Global because
     the elements are created at runtime and never carry Astro's scoping
     attribute. The container never intercepts clicks — the same
     pointerdown that spawned a popup must keep working underneath it. */
  .field-popups {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 30;
    overflow: hidden;
  }

  .field-popup {
    position: absolute;
    transform: translate(-50%, -120%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: rgba(196, 212, 255, 0.9);
    text-shadow: 0 0 12px rgba(128, 168, 255, 0.55);
    animation: field-popup-rise 1.9s ease-out forwards;
  }

  /* Animated via `translate` so it composes with the centering
     `transform` above instead of overwriting it. */
  @keyframes field-popup-rise {
    0% {
      opacity: 0;
      translate: 0 8px;
    }
    12% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -44px;
    }
  }
</style>

<script>
  import { initHomeTimeline } from '../lib/gsap/homeTimeline';
  import { onRoute } from '../lib/lifecycle';

  type HomeSceneHandle = {
    setScrollProgress: (p: number) => void;
    setDissolve: (p: number) => void;
    ripple: (clientX: number, clientY: number, strength?: number) => void;
    dispose: () => void;
  };

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Boots the Three.js particle field (plus the commit-popup layer that
  // rides on its ripples) and returns a composite handle, or null when the
  // scene is skipped (mobile / reduced-motion / missing canvas) or fails to
  // init. The GSAP timeline is owned by the caller, not here.
  const bootHomeScene = async (): Promise<HomeSceneHandle | null> => {
    const canvas = document.getElementById('home-canvas') as HTMLCanvasElement | null;

    // Lazy-load the Three.js scene only on capable devices.
    // Skip on very small screens or when the canvas is missing.
    const isSmall = window.matchMedia('(max-width: 640px)').matches;
    const skipScene = !canvas || reducedMotion || isSmall;

    if (!skipScene && canvas) {
      let popups: { spawn: (x: number, y: number) => void; dispose: () => void } | null =
        null;
      try {
        let commitMessages: string[] = [];
        const raw = canvas.dataset.commitMessages;
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              commitMessages = parsed.filter((s): s is string => typeof s === 'string');
            }
          } catch {
            // Bad JSON shouldn't kill the scene — popups fall back to defaults.
          }
        }
        const [{ createHomeScene }, { buildCommitPopups }] = await Promise.all([
          import('../lib/three/homeScene'),
          import('../lib/home/commitPopups'),
        ]);
        popups = buildCommitPopups(commitMessages);
        const boundPopups = popups;

        // Discoverability hint: once per SESSION (sessionStorage, same
        // persistence pattern as the audio state), after the name forms,
        // and only if the visitor hasn't already clicked or scrolled.
        // The session flag is set on the first formation either way — a
        // visitor who discovered clicking organically shouldn't get the
        // hint on a later SPA re-visit.
        const HINT_KEY = 'mn_field_hint_shown';
        let interacted = false;
        const markInteracted = (): void => {
          interacted = true;
        };
        window.addEventListener('pointerdown', markInteracted, {
          capture: true,
          once: true,
        });

        let fieldScene: Awaited<ReturnType<typeof createHomeScene>> | null = null;
        const scene = await createHomeScene({
          canvas,
          onRipple: (x, y) => boundPopups.spawn(x, y),
          onFormed: () => {
            try {
              if (sessionStorage.getItem(HINT_KEY)) return;
              sessionStorage.setItem(HINT_KEY, '1');
            } catch {
              return; // storage unavailable — skip the hint entirely
            }
            if (interacted || window.scrollY > 4) return;
            // Below the name block — the wave brushes the letters gently
            // at its decayed edge instead of bending them at full force.
            fieldScene?.ripple(window.innerWidth * 0.5, window.innerHeight * 0.78, 1);
          },
        });
        fieldScene = scene;
        return {
          ...scene,
          dispose: (): void => {
            window.removeEventListener('pointerdown', markInteracted, {
              capture: true,
            });
            scene.dispose();
            boundPopups.dispose();
          },
        };
      } catch (err) {
        popups?.dispose();
        console.warn('home scene failed to init', err);
      }
    } else if (canvas) {
      // Hide the canvas on mobile / reduced-motion so the flat page
      // background shows through
      canvas.style.display = 'none';
      const fallback = document.querySelector('.hero__title-fallback');
      if (fallback) (fallback as HTMLElement).style.display = 'block';
    }
    return null;
  };

  // Mount on every arrival at home, dispose on leaving. BOTH the scene and the
  // timeline are disposed — the timeline handle was previously discarded, so its
  // ScrollTriggers leaked on every navigation.
  onRoute(
    () => !!document.getElementById('home-canvas'),
    () => {
      let sceneHandle: HomeSceneHandle | null = null;
      let disposed = false;

      // Timeline is synchronous; onScrollProgress reads sceneHandle lazily, so it
      // works even though the scene resolves asynchronously below.
      const timeline = initHomeTimeline({
        reducedMotion,
        onScrollProgress: (p) => sceneHandle?.setScrollProgress(p),
        onHeroProgress: (p) => sceneHandle?.setDissolve(p),
      });

      // If disposed (navigated away) before the async scene resolves, dispose the
      // latecomer immediately rather than leak a WebGL context onto a gone page.
      void bootHomeScene().then((handle) => {
        if (disposed) {
          handle?.dispose();
          return;
        }
        sceneHandle = handle;
      });

      return () => {
        disposed = true;
        sceneHandle?.dispose();
        sceneHandle = null;
        timeline.dispose();
      };
    },
  );
</script>
