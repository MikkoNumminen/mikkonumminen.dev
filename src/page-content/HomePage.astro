---
import { execSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Intro from '../components/home/Intro.astro';
import Focus from '../components/home/Focus.astro';
import Integrations from '../components/home/Integrations.astro';
import Velocity from '../components/home/Velocity.astro';
import NavCards from '../components/home/NavCards.astro';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Recent commit subjects, baked in at build time. Drives the impact-text
// popups that burst from each meteor strike on the home hero galaxy.
// Filtered to drop merges and any defensive Claude refs (committed files
// must not reference the AI tooling — see project guide). Falls back to
// an empty array outside a git checkout; the scene then uses its own
// hardcoded sentinel list.
let commitMessages: string[] = [];
try {
  commitMessages = execSync('git log --pretty=format:%s -n 80', {
    encoding: 'utf8',
  })
    .split('\n')
    .map((s) => s.trim())
    .filter((s) => s.length > 0)
    .filter((s) => !/^Merge /i.test(s))
    .filter((s) => !/claude/i.test(s))
    .filter((s, i, arr) => arr.indexOf(s) === i)
    .slice(0, 50);
} catch {
  commitMessages = [];
}

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mikko Numminen',
  jobTitle: t.intro.heading.replace(/\.$/, ''),
  url: 'https://mikkonumminen.dev',
  email: 'numminen.mikko.petteri@gmail.com',
  nationality: 'Finnish',
  sameAs: [
    'https://github.com/MikkoNumminen',
    'https://www.linkedin.com/in/mikko-numminen-269795205/',
  ],
  knowsAbout: [
    'TypeScript',
    'Python',
    'Next.js',
    'React',
    'Node.js',
    'PostgreSQL',
    'MongoDB',
    'Prisma',
    'Material-UI',
    'Tailwind CSS',
    'Astro',
    'Three.js',
    'Jest',
    'Playwright',
    'Docker',
    'Turborepo',
    'Open data',
    'UI design',
    'Usability',
  ],
};
---

<BaseLayout title={t.meta.home.title} description={t.meta.home.description} theme="home">
  <Fragment slot="head">
    <link
      rel="preload"
      href="/fonts/helvetiker_bold.typeface.json"
      as="fetch"
      type="application/json"
      crossorigin="anonymous"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </Fragment>

  <Hero commitMessages={commitMessages} />
  <Intro />
  <Focus />
  <Integrations />
  <Velocity />
  <NavCards />
</BaseLayout>

<script>
  import { initHomeTimeline } from '../lib/gsap/homeTimeline';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let sceneHandle: {
    setScrollProgress: (p: number) => void;
    dispose: () => void;
  } | null = null;

  const bootHomeScene = async () => {
    const canvas = document.getElementById('home-canvas') as HTMLCanvasElement | null;

    // Lazy-load the Three.js scene only on capable devices.
    // Skip on very small screens or when the canvas is missing.
    const isSmall = window.matchMedia('(max-width: 640px)').matches;
    const skipScene = !canvas || reducedMotion || isSmall;

    if (!skipScene && canvas) {
      try {
        let commitMessages: string[] = [];
        const raw = canvas.dataset.commitMessages;
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              commitMessages = parsed.filter((s): s is string => typeof s === 'string');
            }
          } catch {
            // Bad JSON shouldn't kill the scene — fall back to defaults.
          }
        }
        const { createHomeScene } = await import('../lib/three/homeScene');
        sceneHandle = await createHomeScene({
          canvas,
          fontUrl: '/fonts/helvetiker_bold.typeface.json',
          reducedMotion,
          commitMessages,
        });
      } catch (err) {
        console.warn('home scene failed to init', err);
      }
    } else if (canvas) {
      // Hide the canvas on mobile / reduced-motion so the gradient backdrop shows
      canvas.style.display = 'none';
      const fallback = document.querySelector('.hero__title-fallback');
      if (fallback) (fallback as HTMLElement).style.display = 'block';
    }

    initHomeTimeline({
      reducedMotion,
      onScrollProgress: (p) => sceneHandle?.setScrollProgress(p),
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootHomeScene, { once: true });
  } else {
    bootHomeScene();
  }

  window.addEventListener('beforeunload', () => {
    sceneHandle?.dispose();
  });
</script>
