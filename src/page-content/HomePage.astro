---
import { execSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Intro from '../components/home/Intro.astro';
import LatestEntries from '../components/home/LatestEntries.astro';
import NavCards from '../components/home/NavCards.astro';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Recent commit subjects, baked in at build time. Drives the impact-text
// popups that burst from each meteor strike on the home hero galaxy.
// We strip each subject to its conventional-commit type+scope and only
// keep the ones with an explicit (scope). NO dedup — the popup pool is
// the latest ~40 prefixes in chronological order, repetitions and all,
// so the rhythm reflects what was *actually* committed lately rather
// than a historical hall-of-fame of every scope ever used. Falls back
// to an empty array outside a git checkout; the scene then uses its
// own hardcoded sentinel list.
let commitMessages: string[] = [];
try {
  const subjects = execSync('git log --pretty=format:%s -n 60', {
    encoding: 'utf8',
  })
    .split('\n')
    .map((s) => s.trim())
    .filter((s) => s.length > 0)
    .filter((s) => !/^Merge /i.test(s))
    .map((s) => s.split(':')[0]!.trim())
    .filter((p) => /\([^()]+\)$/.test(p));
  commitMessages = subjects.slice(0, 40);
} catch {
  // Outside a git checkout (e.g. a history-less clone) — leave the empty
  // initializer; the scene falls back to its hardcoded sentinel list.
}

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mikko Numminen',
  jobTitle: t.meta.jobTitle,
  // Read from Astro.site so the JSON-LD url stays in lockstep with the
  // canonical link — otherwise structured data drifts whenever the site
  // host changes (see the comment in astro.config.mjs).
  url: Astro.site?.href ?? 'https://mikkonumminen.dev',
  email: 'numminen.mikko.petteri@gmail.com',
  nationality: 'Finnish',
  sameAs: [
    'https://github.com/MikkoNumminen',
    'https://www.linkedin.com/in/mikko-numminen-269795205/',
  ],
  knowsAbout: [
    'TypeScript',
    'Python',
    'Next.js',
    'React',
    'Node.js',
    'PostgreSQL',
    'MongoDB',
    'Prisma',
    'Material-UI',
    'Tailwind CSS',
    'Astro',
    'Three.js',
    'Jest',
    'Playwright',
    'Docker',
    'Turborepo',
    'Open data',
    'UI design',
    'Usability',
  ],
};
---

<BaseLayout title={t.meta.home.title} description={t.meta.home.description} theme="home">
  <Fragment slot="head">
    <link
      rel="preload"
      href="/fonts/helvetiker_bold.typeface.json"
      as="fetch"
      type="application/json"
      crossorigin="anonymous"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </Fragment>

  <Hero commitMessages={commitMessages} />
  <Intro />
  <LatestEntries />
  <NavCards />
</BaseLayout>

<script>
  import { initHomeTimeline } from '../lib/gsap/homeTimeline';
  import { onRoute } from '../lib/lifecycle';

  type HomeSceneHandle = {
    setScrollProgress: (p: number) => void;
    dispose: () => void;
  };

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Boots the Three.js hero scene and returns its handle, or null when the scene
  // is skipped (mobile / reduced-motion / missing canvas) or fails to init. The
  // GSAP timeline is owned by the caller, not here.
  const bootHomeScene = async (): Promise<HomeSceneHandle | null> => {
    const canvas = document.getElementById('home-canvas') as HTMLCanvasElement | null;

    // Lazy-load the Three.js scene only on capable devices.
    // Skip on very small screens or when the canvas is missing.
    const isSmall = window.matchMedia('(max-width: 640px)').matches;
    const skipScene = !canvas || reducedMotion || isSmall;

    if (!skipScene && canvas) {
      try {
        let commitMessages: string[] = [];
        const raw = canvas.dataset.commitMessages;
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              commitMessages = parsed.filter((s): s is string => typeof s === 'string');
            }
          } catch {
            // Bad JSON shouldn't kill the scene — fall back to defaults.
          }
        }
        const { createHomeScene } = await import('../lib/three/homeScene');
        return await createHomeScene({
          canvas,
          fontUrl: '/fonts/helvetiker_bold.typeface.json',
          reducedMotion,
          commitMessages,
        });
      } catch (err) {
        console.warn('home scene failed to init', err);
      }
    } else if (canvas) {
      // Hide the canvas on mobile / reduced-motion so the gradient backdrop shows
      canvas.style.display = 'none';
      const fallback = document.querySelector('.hero__title-fallback');
      if (fallback) (fallback as HTMLElement).style.display = 'block';
    }
    return null;
  };

  // Mount on every arrival at home, dispose on leaving. BOTH the scene and the
  // timeline are disposed — the timeline handle was previously discarded, so its
  // ScrollTriggers leaked on every navigation.
  onRoute(
    () => !!document.getElementById('home-canvas'),
    () => {
      let sceneHandle: HomeSceneHandle | null = null;
      let disposed = false;

      // Timeline is synchronous; onScrollProgress reads sceneHandle lazily, so it
      // works even though the scene resolves asynchronously below.
      const timeline = initHomeTimeline({
        reducedMotion,
        onScrollProgress: (p) => sceneHandle?.setScrollProgress(p),
      });

      // If disposed (navigated away) before the async scene resolves, dispose the
      // latecomer immediately rather than leak a WebGL context onto a gone page.
      void bootHomeScene().then((handle) => {
        if (disposed) {
          handle?.dispose();
          return;
        }
        sceneHandle = handle;
      });

      return () => {
        disposed = true;
        sceneHandle?.dispose();
        sceneHandle = null;
        timeline.dispose();
      };
    },
  );
</script>
