---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import { asLocale, getTranslations, localizePath } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

const entries = (await getCollection('blog'))
  .filter((entry) => entry.data.locale === locale && !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={t.meta.blog.title} description={t.meta.blog.description} theme="home">
  <section class="blog-index" aria-label={t.blog.title}>
    <header class="blog-index__header">
      <p class="blog-index__eyebrow">{t.blog.eyebrow}</p>
      <h1 class="blog-index__title">{t.blog.title}</h1>
      <p class="blog-index__lede">{t.blog.lede}</p>
    </header>

    {
      entries.length === 0 ? (
        <p class="blog-index__empty">{t.blog.empty}</p>
      ) : (
        <ul class="blog-index__list">
          {entries.map((entry) => (
            <li>
              <PostCard
                entry={entry}
                href={localizePath(`/blog/${entry.data.slug}`, locale)}
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .blog-index {
    max-width: 820px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  .blog-index__header {
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .blog-index__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1rem;
  }

  .blog-index__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    color: #fff;
  }

  .blog-index__lede {
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .blog-index__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blog-index__empty {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }
</style>
