---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/contact/Terminal.astro';
import MobileContactCard from '../components/contact/MobileContactCard.astro';
import Shoutbox from '../components/contact/Shoutbox.astro';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<BaseLayout
  title={t.meta.contact.title}
  description={t.meta.contact.description}
  theme="contact"
  ogImage="/og-contact.png"
>
  <Terminal />
  <MobileContactCard />
  <Shoutbox />
</BaseLayout>

<script>
  import { initTerminal } from '../lib/terminal/terminal';
  import { onRoute } from '../lib/lifecycle';

  // Mount per contact arrival, dispose on leaving. initTerminal returns a
  // Promise<{ dispose }>; onRoute disposes it on the next swap (and, if we
  // navigate away before it resolves, disposes the latecomer) — which also
  // stops the chat-availability poller it starts. Its own `pagehide` self-
  // dispose remains as a full-unload / bfcache fallback.
  onRoute(
    () => !!document.getElementById('terminal-form'),
    () => initTerminal(document),
  );
</script>
