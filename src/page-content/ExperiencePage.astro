---
import BaseLayout from '../layouts/BaseLayout.astro';
import MountainScene from '../components/experience/MountainScene.astro';
import Goat from '../components/experience/Goat.astro';
import TimelineContent from '../components/experience/TimelineContent.astro';
import TechStack from '../components/experience/TechStack.astro';
import SummitExit from '../components/experience/SummitExit.astro';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);
---

<BaseLayout
  title={t.meta.experience.title}
  description={t.meta.experience.description}
  theme="experience"
  ogImage="/og-experience.png"
>
  <!-- Fixed background scene (mountain layers + sun + stars) -->
  <MountainScene />

  <!-- Goat overlay — absolute viewport coords driven by JS lerping toward
       whichever timeline card is currently closest to viewport center. -->
  <Goat />

  <!-- The scrollable track. Total height drives the parallax progress 0..1. -->
  <!-- Technologies sits ABOVE the climb. The page opens at base camp, the
       foot of the document, and everything is reached by scrolling up: the
       history first, the summit, then the stack at the very top. That also
       means the reader only ever has one direction to go from the opening
       view, which the previous arrangement (appendix below base camp) did
       not. -->
  <div class="experience-track" data-experience-track>
    <SummitExit />
    <TechStack />
    <TimelineContent />
  </div>
</BaseLayout>

<script>
  import { initExperienceTimeline } from '../lib/gsap/experienceTimeline';
  import { onRoute } from '../lib/lifecycle';

  // Mount per experience arrival, dispose on leaving — otherwise the timeline's
  // master ScrollTrigger, gsap.ticker callback, and IntersectionObserver would
  // run against stale DOM after a client-side navigation.
  onRoute(
    () => !!document.querySelector('[data-experience-track]'),
    () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      return initExperienceTimeline({ reducedMotion });
    },
  );
</script>

<style is:global>
  /* The base layout body background would peek through during scroll on
     this page since the mountain scene is fixed. Override it. */
  html[data-theme='experience'],
  body[data-theme='experience'] {
    background: #0e0820;
  }

  .experience-track {
    position: relative;
    z-index: 1;
  }
</style>
