---
import '../styles/projects-scene.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectDetail from '../components/projects/ProjectDetail.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import ProjectsVoiceover from '../components/projects/ProjectsVoiceover.astro';
import { localizeProjects } from '../data/projects';
import { asLocale, getTranslations } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Localized list for the side panel — clicking an item triggers the same
// `selectById` flow as clicking the matching planet, so users can jump
// to any project without having to chase a moving target.
const localizedList = localizeProjects(t);
---

<BaseLayout
  title={t.meta.projects.title}
  description={t.meta.projects.description}
  theme="projects"
  ogImage="/og-projects.png"
>
  <!-- Desktop / capable: WebGL solar system. Visible by default; hidden via
       CSS on small viewports / reduced motion so the layout is stable before
       JS runs. The fallback grid is shown via the same CSS rules. -->
  <div class="projects-scene" data-projects-scene>
    <h1 class="sr-only">{t.projectsPage.title}</h1>
    <canvas id="projects-canvas" class="projects-scene__canvas" aria-hidden="true"
    ></canvas>

    <div class="projects-scene__legend" data-legend aria-hidden="true">
      <span><code>hover</code> {t.projectsPage.legendHover}</span>
      <span><code>click</code> {t.projectsPage.legendClick}</span>
      <span><code>drag</code> {t.projectsPage.legendDrag}</span>
      <span><code>scroll</code> {t.projectsPage.legendZoom}</span>
    </div>

    <!-- Loading gate. Shown only while <html> carries .projects-loading, which
         the inline script adds pre-paint and never on the fallback paths, so
         reduced-motion and small-screen visitors are never gated. Revealed on
         measured readiness, with a hard cap so a slow machine is let in rather
         than held. PARALLEL TO the field gate in HomePage.astro. -->
    <div class="projects-gate" data-projects-gate aria-hidden="true">
      <span class="projects-gate__rule"><span class="projects-gate__fill"></span></span>
      <span class="projects-gate__caption">initialising · system</span>
    </div>

    <div class="hover-label" id="hover-label" data-visible="false" aria-hidden="true">
    </div>

    <div class="planet-labels" id="planet-labels" aria-hidden="true"></div>

    <!-- Collapsed to a rail by default: at fourteen projects an always-open
         panel of names *and* taglines covered a third of the viewport, which
         is the same third the outer orbits need. Names only when open; the
         tagline is revealed per-row on hover (and in the planet's hover card,
         which the row's forced-hover already triggers). -->
    <nav
      class="projects-scene__list"
      data-list
      data-expanded="false"
      aria-label={t.projectsPage.listAriaLabel}
    >
      <button
        type="button"
        class="projects-scene__list-toggle"
        data-list-toggle
        aria-expanded="false"
        aria-controls="projects-jump-list"
      >
        <span class="projects-scene__list-toggle-icon" aria-hidden="true"></span>
        <span class="projects-scene__list-toggle-label" data-list-toggle-label
          >{t.projectsPage.listToggleShow}</span
        >
      </button>
      <ul class="projects-scene__list-items" id="projects-jump-list">
        {
          localizedList.map((p) => (
            <li>
              <button
                type="button"
                class="projects-scene__list-item"
                data-project-id={p.id}
                style={`--brand:${p.color}`}
              >
                <span class="projects-scene__list-dot" aria-hidden="true" />
                <span class="projects-scene__list-text">
                  <span class="projects-scene__list-name">{p.name}</span>
                  <span class="projects-scene__list-tagline">
                    <span>{p.tagline}</span>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="projects-scene__credits" data-credits aria-hidden="true">
      <span>{t.navCards.footerCopyright}</span>
      <span class="projects-scene__credits-sep">·</span>
      <span>{t.navCards.footerBuiltWith}</span>
    </div>

    <ProjectDetail />

    <ProjectsVoiceover />
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      try {
        if (window.matchMedia('(max-width: 860px)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('projects-loading');
      } catch {
        /* the gate is progressive enhancement — never block the page */
      }
    })();
  </script>

  <!-- Mobile / no-JS / reduced-motion fallback -->
  <div class="projects-fallback" data-projects-fallback>
    <ProjectGrid />
  </div>
</BaseLayout>

<script>
  // Runtime re-imports — these run in the browser. Astro frontmatter imports
  // above run at build time and aren't in scope here.
  import { localizeProjects } from '../data/projects';
  import { asLocale, getTranslations } from '../i18n';
  import { initProjectDrawer } from '../lib/projects/drawer';
  import { scheduleProjectsSceneBoot } from '../lib/projects/boot';
  import { onRoute } from '../lib/lifecycle';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isSmall = window.matchMedia('(max-width: 860px)').matches;

  // Mount per projects arrival, dispose on leaving. The scene boot is deferred
  // (waits for first interaction / 2 s), so the disposer both `cancel()`s an
  // unfired boot AND disposes the scene/drawer if they did boot; a `disposed`
  // flag also drops a scene whose dynamic import is still resolving when we
  // navigate away, so a WebGL context can't linger on a swapped-away page.
  onRoute(
    () => !!document.querySelector('[data-projects-scene]'),
    () => {
      // Read locale from <html lang> (updated per navigation by the router),
      // then merge structural project data with the localized text.
      const locale = asLocale(document.documentElement.lang);
      const t = getTranslations(locale);
      const localizedProjects = localizeProjects(t);
      const tp = t.projectsPage;

      let sceneHandle: {
        selectById: (id: string | null) => void;
        hoverById: (id: string | null) => void;
        whenReady: () => Promise<void>;
        dispose: () => void;
      } | null = null;
      let drawer: ReturnType<typeof initProjectDrawer> | null = null;
      let disposed = false;

      // Panel wiring, immediately. This used to live inside the deferred WebGL
      // boot, which meant a pure-HTML control had no click handler until a
      // Three.js scene had loaded — the button did nothing on arrival, and the
      // click that finally woke it also kicked off the scene build that froze
      // the main thread. The panel is markup; it works before any of that.
      const wirePanel = (): HTMLElement | null => {
        const panel = document.querySelector<HTMLElement>('[data-list]');
        const listToggle =
          document.querySelector<HTMLButtonElement>('[data-list-toggle]');
        const listItems = document.getElementById('projects-jump-list');
        if (!panel || !listToggle || !listItems) return null;

        const setListExpanded = (expanded: boolean, persist = true) => {
          panel.setAttribute('data-expanded', String(expanded));
          listToggle.setAttribute('aria-expanded', String(expanded));
          // The button's own text is its accessible name — an aria-label here
          // would override the visible words for screen-reader users.
          const label = listToggle.querySelector('[data-list-toggle-label]');
          if (label) label.textContent = expanded ? tp.listToggleHide : tp.listToggleShow;
          listItems.inert = !expanded;
          if (persist) sessionStorage.setItem('projects:list-expanded', String(expanded));
        };
        setListExpanded(
          sessionStorage.getItem('projects:list-expanded') === 'true',
          false,
        );
        listToggle.addEventListener('click', () => {
          setListExpanded(panel.getAttribute('data-expanded') !== 'true');
        });
        return panel;
      };
      const list = wirePanel();

      const sceneRoot = document.querySelector<HTMLElement>('[data-projects-scene]');
      const fallback = document.querySelector<HTMLElement>('[data-projects-fallback]');

      // Gate lifecycle. The scene build blocks the main thread for over a
      // second on a cold load; without this the visitor spends that time
      // clicking into a frozen page. Revealed on the scene's own measured
      // readiness, capped so a slow machine is never held indefinitely, and
      // guarded on `disposed` so a reveal arriving after a fast
      // away-and-back navigation cannot strip the next visit's gate.
      const html = document.documentElement;
      const gateActive = html.classList.contains('projects-loading');
      const gate = document.querySelector<HTMLElement>('[data-projects-gate]');
      let revealed = false;
      let slowTimer = 0;
      let capTimer = 0;
      let unlockTimer = 0;
      const reveal = () => {
        if (revealed || disposed) return;
        revealed = true;
        window.clearTimeout(slowTimer);
        window.clearTimeout(capTimer);
        gate?.classList.add('projects-gate--done');
        unlockTimer = window.setTimeout(
          () => html.classList.remove('projects-loading'),
          380,
        );
      };
      if (gateActive) {
        // The caption only appears if the wait outlasts 300ms, so a fast
        // machine sees a flash rather than a loading screen.
        slowTimer = window.setTimeout(
          () => gate?.classList.add('projects-gate--slow'),
          300,
        );
        capTimer = window.setTimeout(reveal, 4000);
      } else {
        revealed = true;
      }

      const bootProjectsScene = async () => {
        if (reducedMotion || isSmall || !sceneRoot) {
          // CSS @media rules already hide the scene and show the fallback grid
          // for these clients before JS runs. Set the explicit data flag too so
          // the fallback path is observable from CSS / future code, not just an
          // implicit consequence of the WebGL canvas being hidden.
          sceneRoot?.setAttribute('data-fallback-active', 'true');
          fallback?.setAttribute('data-active', 'true');
          reveal();
          return;
        }

        const canvas = document.getElementById(
          'projects-canvas',
        ) as HTMLCanvasElement | null;
        const hoverLabel = document.getElementById('hover-label');
        const planetLabels = document.getElementById('planet-labels');
        const detail = document.getElementById('project-detail');
        const closeBtn = document.getElementById(
          'project-detail-close',
        ) as HTMLButtonElement | null;
        const intro = document.querySelector<HTMLElement>('[data-intro]');
        const legend = document.querySelector<HTMLElement>('[data-legend]');
        const credits = document.querySelector<HTMLElement>('[data-credits]');

        if (!canvas || !hoverLabel || !planetLabels || !detail || !closeBtn) {
          reveal();
          return;
        }

        // Mark the list item matching the selected project, so closing the
        // drawer leaves visible which one was just open. scrollIntoView keeps
        // it in view when the list overflows.
        const scrollBehavior: ScrollBehavior = reducedMotion ? 'auto' : 'smooth';
        const setListSelected = (id: string | null) => {
          if (!list) return;
          list.querySelectorAll<HTMLElement>('[data-project-id]').forEach((btn) => {
            if (btn.getAttribute('data-project-id') === id) {
              btn.setAttribute('data-selected', 'true');
              btn.scrollIntoView({ block: 'nearest', behavior: scrollBehavior });
            } else {
              btn.removeAttribute('data-selected');
            }
          });
        };

        drawer = initProjectDrawer({
          detail,
          closeBtn,
          intro,
          legend,
          credits,
          list,
          labels: { liveDemo: tp.liveDemo, githubLink: tp.githubLink },
          onClose: () => {
            setListSelected(null);
            sceneHandle?.selectById(null);
          },
        });

        // Per-button listeners on the side-panel list. Click selects the
        // project (mirroring planet click); hover/focus mirror the planet's
        // hover (forced-hover scale-up + label) so the user can preview each
        // project from the stationary list. `prepareOpen` hands the trigger
        // to the drawer so closing returns focus to the list item even when
        // the click-outside handler's interim close shifts activeElement.
        // (These live on the list buttons, which the router swaps out on
        // navigation, so they're GC'd with the DOM — no explicit teardown.)
        list?.querySelectorAll<HTMLButtonElement>('[data-project-id]').forEach((btn) => {
          const id = btn.getAttribute('data-project-id');
          if (!id) return;
          btn.addEventListener('click', () => {
            drawer?.prepareOpen(btn);
            sceneHandle?.selectById(id);
          });
          btn.addEventListener('mouseenter', () => sceneHandle?.hoverById(id));
          btn.addEventListener('mouseleave', () => sceneHandle?.hoverById(null));
          btn.addEventListener('focus', () => sceneHandle?.hoverById(id));
          btn.addEventListener('blur', () => sceneHandle?.hoverById(null));
        });

        try {
          const { createProjectsScene } = await import('../lib/three/projectsScene');
          // Navigated away while the scene module was importing — the disposer
          // already tore down the drawer, so just bail before creating a scene
          // that would leak a WebGL context onto the page we've left.
          if (disposed) return;
          sceneHandle = createProjectsScene({
            canvas,
            hoverLabel,
            planetLabels,
            projects: localizedProjects,
            reducedMotion,
            onSelect: (project) => {
              setListSelected(project.id);
              drawer?.open(project);
            },
            onDeselect: () => {
              /* triggered by drawer.close via onClose */
            },
          });
          // Reveal on the scene's own measured readiness — warm frames under
          // the jank threshold — rather than on a timer that would guess.
          void sceneHandle.whenReady().then(reveal);
        } catch (err) {
          console.warn('projects scene failed to init', err);
          reveal();
          sceneRoot.setAttribute('data-fallback-active', 'true');
          fallback?.setAttribute('data-active', 'true');
          drawer?.dispose();
        }
      };

      const bootHandle = scheduleProjectsSceneBoot({ onBoot: bootProjectsScene });

      return () => {
        disposed = true;
        window.clearTimeout(slowTimer);
        window.clearTimeout(capTimer);
        window.clearTimeout(unlockTimer);
        html.classList.remove('projects-loading');
        bootHandle.cancel();
        sceneHandle?.dispose();
        drawer?.dispose();
      };
    },
  );
</script>
