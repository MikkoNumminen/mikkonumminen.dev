# Backend configuration. Copy to `.env` and adjust; never commit the real `.env`
# (it is gitignored). Every value below has a working default in config.py — this
# file documents them and is the override surface for the Docker stack.

# --- Database (Postgres + pgvector) ---
# Inside docker compose the host is the `db` service; on the host it's localhost.
DATABASE_URL=postgresql://rag:rag@db:5432/rag

# --- Content + embeddings ---
# Directory the indexer reads (compose mounts the repo's ./content here).
CONTENT_DIR=content
# Embedding model + the dimension it emits. The dimension is locked to the model:
# changing it requires a matching change to the vector(N) column in sql/001_init.sql
# and a full re-index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Chunker (token counts are estimates; see chunking.estimate_tokens) ---
CHUNK_MAX_TOKENS=480
CHUNK_MIN_TOKENS=100
CHUNK_OVERLAP_TOKENS=60

# --- Generation LLM (used by the Phase 2 query path) ---
# Always the local Gemma served by Ollama over its OpenAI-compatible endpoint.
# No API key — there is no hosted model and no paid API, ever.
OLLAMA_BASE_URL=http://ollama:11434/v1
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT_SECONDS=60
# Generation tuning — the ragctl CLI's "effort". Low temperature suits grounded
# RAG; LLM_NUM_PREDICT caps answer length (defaults to 512 so answers can't run
# away into whole-document dumps; set 0 for no cap / the model default).
LLM_TEMPERATURE=0.4
LLM_NUM_PREDICT=512
# Force every answer into English regardless of the question's language. On by
# default: small models obey a system-prompt "answer in English" rule
# unreliably, so this also prepends an in-message directive. Toggle via
# `ragctl english on|off`. Set 0/false/no/off to allow the question's language.
FORCE_ENGLISH=1
# Served context window — read by the OLLAMA service (not the backend) via the
# repo .env / docker-compose. The ragctl CLI's --context sets it. Default 4096.
OLLAMA_CONTEXT_LENGTH=4096

# --- Retrieval + API ---
# How many nearest chunks to retrieve and ground the answer in. Raised to 6
# with the deeper corpus so specific questions pull the right chunk; keep it
# small enough that the chunks fit the model's context window (raise context
# via OLLAMA_CONTEXT_LENGTH if you push this higher).
TOP_K=6
# Comma-separated CORS origins allowed to call the API. Default "*" for local
# dev; in prod set the real site origin(s), e.g. https://mikkonumminen.dev
CORS_ALLOW_ORIGINS=*

# --- Guardrails (Phase 4) ---
# Cosine distance above which even the closest retrieved chunk is treated as
# irrelevant -> deterministic refusal instead of generation. Conservative;
# tune with `python -m evals.run_eval`.
WEAK_RETRIEVAL_DISTANCE=0.7
# Per-IP sliding-window rate limit + a request-body byte cap (protect the
# machine while the tunnel is open).
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=16384
