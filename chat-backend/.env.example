# Backend configuration. Copy to `.env` and adjust; never commit the real `.env`
# (it is gitignored). Every value below has a working default in config.py — this
# file documents them and is the override surface for the Docker stack.

# --- Database (Postgres + pgvector) ---
# Inside docker compose the host is the `db` service; on the host it's localhost.
DATABASE_URL=postgresql://rag:rag@db:5432/rag

# --- Content + embeddings ---
# Directory the indexer reads (compose mounts the repo's ./content here).
CONTENT_DIR=content
# Phase 1 corpus expansion: an extra directory of ADR / design-note markdown
# (NNNN-*.md) ingested as doc_type='adr' prose, attributed to ADR_PROJECT. The
# compose mounts the repo's ./docs/decisions here; only the indexer reads it.
# Leave empty to turn the ADR ingestion off.
ADR_DIR=/adr
ADR_PROJECT=portfolio
# Embedding model + the dimension it emits. The dimension is locked to the model:
# changing it requires a matching change to the vector(N) column in sql/001_init.sql
# and a full re-index.
# Locked to the model baked into the image at build time (chat-backend/Dockerfile);
# the runtime is HF_HUB_OFFLINE=1, so changing this to a non-baked model crashes the
# container at startup. To change models, edit the Dockerfile bake line + rebuild.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Chunker (token counts are estimates; see chunking.estimate_tokens) ---
CHUNK_MAX_TOKENS=480
CHUNK_MIN_TOKENS=100
CHUNK_OVERLAP_TOKENS=60

# --- Generation LLM (used by the Phase 2 query path) ---
# Always a local model served by Ollama over its OpenAI-compatible endpoint.
# No API key — there is no hosted model and no paid API, ever.
OLLAMA_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60
# Generation tuning — the ragctl CLI's "effort". Low temperature suits grounded
# RAG; LLM_NUM_PREDICT caps answer length (defaults to 512 so answers can't run
# away into whole-document dumps; set 0 for no cap / the model default).
LLM_TEMPERATURE=0.4
LLM_NUM_PREDICT=512
# Force every answer into English regardless of the question's language. On by
# default: small models obey a system-prompt "answer in English" rule
# unreliably, so this also prepends an in-message directive. Toggle via
# `ragctl english on|off`. Set 0/false/no/off to allow the question's language.
FORCE_ENGLISH=1
# Progressive disclosure (Phase 5): a concise answer plus an explicit "tell me
# more?" offer; a topic-less follow-up ("yes" / "tell me more") expands into that
# topic's precomputed narrative. On by default; 0/false restores single-shot answers.
PROGRESSIVE_DISCLOSURE_ENABLED=1
# Served context window — read by the OLLAMA service (not the backend) via the
# repo .env / docker-compose. The ragctl CLI's --context sets it. Default 4096.
OLLAMA_CONTEXT_LENGTH=4096
# Mirrors OLLAMA_CONTEXT_LENGTH so the backend can report the real num_ctx in
# the `context` SSE frame that drives the frontend's context-window donut.
CONTEXT_WINDOW=4096

# --- Retrieval + API ---
# How many nearest chunks to retrieve and ground the answer in. Raised to 6
# with the deeper corpus so specific questions pull the right chunk; keep it
# small enough that the chunks fit the model's context window (raise context
# via OLLAMA_CONTEXT_LENGTH if you push this higher).
TOP_K=6
# --- Hybrid retrieval (Workstream B) ---
# Fuse a lexical (full-text/BM25-style) search with the dense vector search via
# reciprocal rank fusion, so exact identifiers (class/engine names, file paths)
# the embeddings blur still surface. Set HYBRID_ENABLED=false to restore pure
# dense retrieval. RRF_K is the standard fusion constant; the weights bias the
# two ranked lists. PROJECT_FILTER_STRICT hard-restricts retrieval to a project
# the query names (vs soft-boosting it).
HYBRID_ENABLED=true
RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_LEXICAL_WEIGHT=1.0
PROJECT_FILTER_STRICT=true
# Comma-separated CORS origins allowed to call the API. Default "*" for local
# dev; in prod set the real site origin(s), e.g. https://mikkonumminen.dev
CORS_ALLOW_ORIGINS=*
# Doc-type exclusion: comma-separated genres to hide from visitor retrieval so
# self-documentation (e.g. ADRs) doesn't crowd out showcased project chunks.
# Default "adr". Set to empty string to disable the filter entirely.
RETRIEVAL_EXCLUDE_DOC_TYPES=adr
# Per-project diversity cap for GENERIC queries (no project named, e.g. "tell me
# about the projects"). At most this many chunks from any single project appear in
# the returned top_k, so multiple showcased projects spread across the answer.
# Named-project queries are never capped. Default 1 (max spread — one chunk per
# project — so a "the projects" answer names as many showcased projects as fit).
RETRIEVAL_DIVERSITY_MAX_PER_PROJECT=1

# --- Guardrails (Phase 4) ---
# Cosine distance above which even the closest retrieved chunk is treated as
# irrelevant -> deterministic refusal instead of generation. Tuned for the
# code-enriched corpus (Workstream B): indexed source lowers off-topic nearest-
# neighbour distances (~0.5 for trivia) toward the grounded band (<=0.34), so the
# threshold sits between them. Tune with `python -m evals.run_eval`.
WEAK_RETRIEVAL_DISTANCE=0.45
# Per-IP sliding-window rate limit + a request-body byte cap (protect the
# machine while the tunnel is open).
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=16384

# --- Containment (Workstream A) ---
# Hard cap on the question length (characters) that reaches the model, enforced
# in the /chat handler before retrieval/generation. The operative limit; the
# Pydantic model keeps only a looser backstop. Longer questions get a clean 400.
INPUT_MAX_CHARS=800
# One local GPU serves generation. Bound concurrent generations and how long a
# request waits for a free slot before being shed with a clean "busy" reply
# (shedding, not queueing — a queue just stacks timeouts behind a slow answer).
LLM_MAX_CONCURRENCY=2
LLM_ACQUIRE_TIMEOUT_SECONDS=0.5
# Local request log. ON by default with OPERATIONAL telemetry only — timestamp,
# route, latency_ms, model + real prompt_eval/eval token counts, retrieval
# distances/best_distance, role + classification counts. No PII (no question or
# answer text), so it's safe for the public deployment; it answers "p95 latency"
# and "which queries retrieved nothing". Set empty to disable. `ragctl up` points
# it at the bind-mounted /srv/rag-logs/requests.jsonl; `ragctl logs` reads it back.
RAG_LOG_FILE=rag-logs/requests.jsonl
# Also write the raw query + answer TEXT into each log line (the one place both
# are recorded). OFF by default — local debugging only; leave off in production.
RAG_LOG_TEXT=false

# --- GDPR-aware context control (Phase 2) ---
# Path to a JSON policy that classifies content at ingest (public | internal |
# restricted | pii), maps roles to the classes they may retrieve, and lists
# pseudonymisation patterns. Empty = the benign default (everything public, one
# public role, no pseudonymisation), so the chat is unchanged out of the box. See
# gdpr-policy.example.json for the shape; a malformed policy fails startup loudly.
GDPR_POLICY_FILE=

# --- Session memory (Phase 4) ---
# Backend conversation memory so a follow-up ("tell me more") has a referent.
# Bounded on every axis: at most MEMORY_MAX_TURNS prior turns threaded per session,
# at most MEMORY_MAX_SESSIONS sessions kept (least-recently-used evicted), and a
# session expires after MEMORY_TTL_SECONDS idle. In-process and non-persistent
# (cleared on restart); the per-turn input cap, relevance gate, role filter, and
# output cap still fire regardless.
MEMORY_MAX_TURNS=6
MEMORY_MAX_SESSIONS=1000
MEMORY_TTL_SECONDS=1800
