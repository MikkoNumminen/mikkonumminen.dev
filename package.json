{
  "name": "mikkonumminen.dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "check:env": "node scripts/check-env.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:skills-pdf": "node scripts/build-skills-pdf.mjs",
    "build:review-stats": "node scripts/build-review-stats.mjs",
    "sync:skills-registry": "node scripts/sync-skill-registry.mjs",
    "render:audit-pdfs": "node scripts/render-audit-pdfs.mjs",
    "prebuild": "npm run validate:registry && npm run render:audit-pdfs && npm run build:skills-pdf",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,astro,json,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,astro,json,css}\" \"*.{ts,mjs,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:registry": "node scripts/validate-registry.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@sentry/astro": "^10.65.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.185.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^2.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
