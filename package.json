{
  "name": "mikkonumminen.dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm run test:coverage && npm run build",
    "verify:backend": "cd chat-backend && ruff check . && mypy app evals ragctl.py && pytest",
    "verify:e2e": "playwright install --with-deps chromium && npm run test:e2e",
    "check:env": "node scripts/check-env.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:skills-pdf": "node scripts/build-skills-pdf.mjs",
    "build:review-stats": "node scripts/build-review-stats.mjs",
    "sync:skills-registry": "node scripts/sync-skill-registry.mjs",
    "render:audit-pdfs": "node scripts/render-audit-pdfs.mjs",
    "blog:drafts": "node scripts/generate-blog-drafts.mjs",
    "prebuild": "npm run validate:registry && npm run validate:shoutbox && npm run render:audit-pdfs && npm run build:skills-pdf && npm run build:cv-pdf",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,astro,json,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,astro,json,css}\" \"*.{ts,mjs,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:shoutbox": "node scripts/validate-shoutbox.mjs",
    "build:cv-pdf": "node scripts/build-cv-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sentry/browser": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
