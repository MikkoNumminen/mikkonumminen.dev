    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@sentry/astro": "^10.57.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.4.6",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.8",
    "astro-eslint-parser": "^1.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
