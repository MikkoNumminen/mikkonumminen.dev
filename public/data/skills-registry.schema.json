{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mikkonumminen.dev/data/skills-registry.schema.json",
  "title": "Skills registry",
  "description": "The portfolio skills inventory served to the contact-page terminal. The published contract for public/data/skills-registry.json. Enforced at build time by scripts/validate-registry.mjs and at runtime by parseRegistry() in src/lib/terminal/skills.ts.",
  "type": "object",
  "required": ["generated_at", "repos", "totals"],
  "additionalProperties": true,
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the registry was generated."
    },
    "repos": {
      "type": "array",
      "items": { "$ref": "#/definitions/repo" }
    },
    "totals": {
      "type": "object",
      "required": ["skills", "redirects", "with_receipts", "annual_tokens_saved"],
      "additionalProperties": true,
      "properties": {
        "skills": { "type": "number" },
        "redirects": { "type": "number" },
        "with_receipts": { "type": "number" },
        "annual_tokens_saved": { "type": "number" }
      }
    },
    "built_in_references": {
      "type": "array",
      "description": "Tracked built-ins (e.g. /review). Present once the overlay runs; consumed by the PDF renderer, not the terminal.",
      "items": { "$ref": "#/definitions/builtInReference" }
    }
  },
  "definitions": {
    "repo": {
      "type": "object",
      "required": ["name", "skills"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "github_url": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/definitions/skill" }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "description", "redirect", "receipt"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "redirect": { "type": "boolean" },
        "last_audited": { "type": "string" },
        "receipt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/receipt" }]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "source"],
      "properties": {
        "path": { "type": "string" },
        "source": { "type": "string" },
        "tokens_per_use": { "type": ["number", "null"] },
        "uses_per_year": { "type": ["number", "null"] },
        "annual_total": { "type": ["number", "null"] }
      }
    },
    "builtInReference": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
